# Set default behavior to automatically normalize line endings
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted
*.cs text diff=csharp
*.cshtml text
*.razor text
*.json text
*.md text
*.xml text
*.props text
*.targets text
*.sln text
*.slnx text
*.yml text
*.yaml text
*.sql text
*.sh text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Denote all binary files that should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.zip binary
*.dll binary
*.exe binary
