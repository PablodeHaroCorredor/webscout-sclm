@page "/kraal/actividades"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize(Roles = RolesScout.AreaKraal)]
@inject IServicioActividades ServicioActividades
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject ITenantContext Tenant

<PageTitle>Gestor de Actividades · Kraal</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3 mb-4">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 700;">Gestor de Actividades y Campamentos</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Convocatorias por ramas pedagógicas y salidas para @(Tenant.IsResolved ? Tenant.GroupName : "el grupo scout").
            </MudText>
        </div>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="AbrirDialogoNuevaActividadAsync">
            Nueva Convocatoria
        </MudButton>
    </div>

    <!-- Barra de Filtros -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="4">
                <MudSelect T="EstadoActividad?" 
                           Label="Filtrar por Estado" 
                           Value="_estadoFiltro" 
                           ValueChanged="OnEstadoFiltroChangedAsync"
                           Variant="Variant.Outlined" 
                           Margin="Margin.Dense" 
                           Clearable="true">
                    <MudSelectItem Value="@((EstadoActividad?)null)">Todos los estados</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.Borrador)">Borrador (Kraal)</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.Publicada)">Publicada (Familias)</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.InscripcionesCerradas)">Inscripciones Cerradas</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.EnCurso)">En Curso</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.Finalizada)">Finalizada</MudSelectItem>
                    <MudSelectItem Value="@((EstadoActividad?)EstadoActividad.Cancelada)">Cancelada</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="RamaScout?" 
                           Label="Filtrar por Rama" 
                           Value="_ramaFiltro" 
                           ValueChanged="OnRamaFiltroChangedAsync"
                           Variant="Variant.Outlined" 
                           Margin="Margin.Dense" 
                           Clearable="true">
                    <MudSelectItem Value="@((RamaScout?)null)">Todas las ramas</MudSelectItem>
                    <MudSelectItem Value="@((RamaScout?)RamaScout.Castores)">Castores</MudSelectItem>
                    <MudSelectItem Value="@((RamaScout?)RamaScout.Manada)">Manada</MudSelectItem>
                    <MudSelectItem Value="@((RamaScout?)RamaScout.Tropa)">Tropa</MudSelectItem>
                    <MudSelectItem Value="@((RamaScout?)RamaScout.Escultas)">Escultas</MudSelectItem>
                    <MudSelectItem Value="@((RamaScout?)RamaScout.Clan)">Clan</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4" Class="text-sm-end">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Total: <strong>@_actividades.Count</strong> actividades encontradas
                </MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Tabla de Actividades -->
    <MudTable Items="@_actividades" 
              Dense="true" 
              Hover="true" 
              Elevation="0" 
              Outlined="true" 
              Loading="@_cargando" 
              LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Tipo</MudTh>
            <MudTh>Título y Lugar</MudTh>
            <MudTh>Ramas</MudTh>
            <MudTh>Fechas</MudTh>
            <MudTh>Cuota (€)</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh Class="text-end">Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Tipo">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ObtenerColorTipo(context.Tipo)">
                    @context.Tipo.ToString()
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Título">
                <MudText Typo="Typo.body2" Style="font-weight: 700;">@context.Titulo</MudText>
                <div class="d-flex align-center gap-1 mud-text-secondary">
                    <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.9rem;" />
                    <MudText Typo="Typo.caption">@context.Lugar</MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="Ramas">
                @if (context.RamasDestinatarias.Count == 0)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Grupo Completo</MudChip>
                }
                else
                {
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var rama in context.RamasDestinatarias)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@rama.ToString()</MudChip>
                        }
                    </div>
                }
            </MudTd>
            <MudTd DataLabel="Fechas">
                <MudText Typo="Typo.body2">@context.FechaInicio.AHoraEspana().ToString("dd/MM/yyyy HH:mm")</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Hasta @context.FechaFin.AHoraEspana().ToString("dd/MM/yyyy HH:mm")</MudText>
            </MudTd>
            <MudTd DataLabel="Cuota">
                <MudText Typo="Typo.body2" Style="font-weight: 700;">
                    @(context.Precio == 0 ? "Gratuita" : $"{context.Precio:N2} €")
                </MudText>
            </MudTd>
            <MudTd DataLabel="Estado">
                <ScoutStatusBadge Estado="context.Estado" />
            </MudTd>
            <MudTd DataLabel="Acciones" Class="text-end">
                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.FolderShared" IconColor="Color.Info" Href="@($"/kraal/actividades/{context.Id}/dossier")">
                        Dossier y Asistencia
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.PeopleAlt" IconColor="Color.Primary" OnClick="@(() => VerInscripcionesAsync(context))">
                        Inscripciones y Plazas
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Visibility" OnClick="@(() => VerDetalleAsync(context))">
                        Ver Detalles
                    </MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditarActividadAsync(context))">
                        Editar Convocatoria
                    </MudMenuItem>
                    @if (context.Estado == EstadoActividad.Borrador)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Publish" OnClick="@(() => CambiarEstadoAsync(context, EstadoActividad.Publicada))">
                            Publicar para Familias
                        </MudMenuItem>
                    }
                    else if (context.Estado == EstadoActividad.Publicada)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.LockClock" OnClick="@(() => CambiarEstadoAsync(context, EstadoActividad.InscripcionesCerradas))">
                            Cerrar Plazo Inscripción
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Drafts" OnClick="@(() => CambiarEstadoAsync(context, EstadoActividad.Borrador))">
                            Volver a Borrador
                        </MudMenuItem>
                    }
                    @if (context.Estado != EstadoActividad.Cancelada)
                    {
                        <MudDivider />
                        <MudMenuItem Icon="@Icons.Material.Filled.Cancel" IconColor="Color.Error" OnClick="@(() => CambiarEstadoAsync(context, EstadoActividad.Cancelada))">
                            Cancelar Actividad
                        </MudMenuItem>
                    }
                    @if (context.Estado == EstadoActividad.Borrador || context.Estado == EstadoActividad.Cancelada)
                    {
                        @if (context.Estado == EstadoActividad.Cancelada)
                        {
                            <MudDivider />
                        }
                        <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="@(() => EliminarActividadAsync(context))">
                            Eliminar Definitivamente
                        </MudMenuItem>
                    }
                </MudMenu>
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <div class="pa-4 text-center">
                <MudText Typo="Typo.body2" Class="mud-text-secondary">No se han encontrado convocatorias con los filtros seleccionados.</MudText>
            </div>
        </NoRecordsContent>
    </MudTable>
</MudContainer>

@code {
    private IReadOnlyList<ActividadScout> _actividades = [];
    private bool _cargando = true;
    private bool _cambiandoEstado;
    private EstadoActividad? _estadoFiltro;
    private RamaScout? _ramaFiltro;
    private Guid _usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var idClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(idClaim, out var parsedId))
        {
            _usuarioActualId = parsedId;
        }

        await CargarActividadesAsync();
    }

    private async Task CargarActividadesAsync()
    {
        _cargando = true;
        try
        {
            _actividades = await ServicioActividades.ObtenerActividadesKraalAsync(_estadoFiltro, _ramaFiltro);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnEstadoFiltroChangedAsync(EstadoActividad? nuevoEstado)
    {
        _estadoFiltro = nuevoEstado;
        await CargarActividadesAsync();
    }

    private async Task OnRamaFiltroChangedAsync(RamaScout? nuevaRama)
    {
        _ramaFiltro = nuevaRama;
        await CargarActividadesAsync();
    }

    private async Task AbrirDialogoNuevaActividadAsync()
    {
        var parameters = new DialogParameters<EditarActividadDialog>
        {
            { x => x.ScouterId, _usuarioActualId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditarActividadDialog>("Nueva Convocatoria", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarActividadesAsync();
        }
    }

    private async Task EditarActividadAsync(ActividadScout actividad)
    {
        var parameters = new DialogParameters<EditarActividadDialog>
        {
            { x => x.ActividadExistente, actividad },
            { x => x.ScouterId, _usuarioActualId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<EditarActividadDialog>("Editar Convocatoria", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarActividadesAsync();
        }
    }

    private async Task VerInscripcionesAsync(ActividadScout actividad)
    {
        var parameters = new DialogParameters<KraalInscripcionesDialog>
        {
            { x => x.Actividad, actividad },
            { x => x.ScouterId, _usuarioActualId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<KraalInscripcionesDialog>(actividad.Titulo, parameters, options);
    }

    private async Task VerDetalleAsync(ActividadScout actividad)
    {
        var parameters = new DialogParameters<DetalleActividadDialog>
        {
            { x => x.Actividad, actividad }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        await DialogService.ShowAsync<DetalleActividadDialog>(actividad.Titulo, parameters, options);
    }

    private async Task CambiarEstadoAsync(ActividadScout actividad, EstadoActividad nuevoEstado)
    {
        if (_cambiandoEstado) return;

        // Toda transición visible para las familias se confirma: un clic desviado en el menú no debe publicar ni cancelar.
        var (titulo, mensaje, textoSi) = nuevoEstado switch
        {
            EstadoActividad.Publicada => ("Publicar convocatoria",
                $"«{actividad.Titulo}» será visible para las familias de las ramas convocadas y se abrirán las inscripciones.",
                "Publicar"),
            EstadoActividad.InscripcionesCerradas => ("Cerrar plazo de inscripción",
                $"Las familias ya no podrán inscribirse en «{actividad.Titulo}». Las inscripciones existentes se mantienen.",
                "Cerrar plazo"),
            EstadoActividad.Borrador => ("Volver a borrador",
                $"«{actividad.Titulo}» dejará de ser visible para las familias hasta que se vuelva a publicar.",
                "Volver a borrador"),
            EstadoActividad.Cancelada => ("Cancelar actividad",
                $"«{actividad.Titulo}» quedará cancelada para todas las familias. Esta acción no se puede deshacer desde el gestor.",
                "Sí, cancelar actividad"),
            _ => ("Cambiar estado", $"¿Cambiar «{actividad.Titulo}» a {nuevoEstado.ObtenerNombre()}?", "Confirmar")
        };

        bool? confirmar = await DialogService.ShowMessageBoxAsync(titulo, mensaje, yesText: textoSi, cancelText: "Volver");
        if (confirmar != true) return;

        _cambiandoEstado = true;
        try
        {
            await ServicioActividades.CambiarEstadoActividadAsync(actividad.Id, nuevoEstado);
            Snackbar.Add($"«{actividad.Titulo}»: {nuevoEstado.ObtenerNombre()}", Severity.Success);
            await CargarActividadesAsync();
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception)
        {
            Snackbar.Add("No se pudo cambiar el estado de la actividad. Inténtalo de nuevo.", Severity.Error);
        }
        finally
        {
            _cambiandoEstado = false;
        }
    }

    private async Task EliminarActividadAsync(ActividadScout actividad)
    {
        bool? confirmar = await DialogService.ShowMessageBoxAsync(
            "Eliminar Actividad",
            $"¿Estás seguro de que deseas eliminar permanentemente la actividad '{actividad.Titulo}'?",
            yesText: "Sí, eliminar",
            cancelText: "Cancelar");

        if (confirmar == true)
        {
            try
            {
                await ServicioActividades.EliminarActividadAsync(actividad.Id);
                Snackbar.Add("Actividad eliminada", Severity.Success);
                await CargarActividadesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private Color ObtenerColorTipo(TipoActividad tipo) => tipo switch
    {
        TipoActividad.Reunion => Color.Default,
        TipoActividad.Salida => Color.Info,
        TipoActividad.Acampada => Color.Primary,
        TipoActividad.Campamento => Color.Secondary,
        _ => Color.Default
    };
}
