@page "/login"
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Hosting
@inject ITenantContext Tenant
@inject NavigationManager Navigation
@inject IWebHostEnvironment Entorno

<PageTitle>Acceso a Mi Espacio · @(Tenant.IsResolved && Tenant.CurrentTenantId != Guid.Empty ? Tenant.GroupName : "WebScout SCLM")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center py-8" Style="min-height: 85vh;">
    <MudCard Elevation="4" Class="rounded-xl w-100 pa-4 pa-sm-6" Style="background: #FFFFFF; border: 1px solid #E2E8F0;">
        
        <!-- Cabecera de Identidad Visual del Grupo o Federación -->
        <MudCardHeader Class="flex-column align-center text-center pb-3">
            <MudAvatar Color="@(Tenant.CurrentTenantId == Guid.Empty ? Color.Secondary : Color.Primary)" 
                       Variant="Variant.Filled" 
                       Size="Size.Large" 
                       Class="mb-3" 
                       Style="width: 56px; height: 56px; font-weight: 800; font-size: 1.25rem;">
                @if (Tenant.CurrentTenantId != Guid.Empty)
                {
                    <span>@Tenant.GroupNumber</span>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Large" />
                }
            </MudAvatar>

            <MudChip T="string" 
                     Size="Size.Small" 
                     Color="@(Tenant.CurrentTenantId == Guid.Empty ? Color.Secondary : Color.Primary)" 
                     Variant="Variant.Filled" 
                     Class="mb-1">
                @(Tenant.CurrentTenantId != Guid.Empty ? $"Grupo Scout Nº {Tenant.GroupNumber}" : "Federación SCLM")
            </MudChip>

            <MudText Typo="Typo.h5" Style="font-weight: 800; color: #0F172A; letter-spacing: -0.02em;">
                @(Tenant.CurrentTenantId != Guid.Empty ? Tenant.GroupName : "Scouts de Castilla-La Mancha")
            </MudText>
            
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                @(Tenant.CurrentTenantId != Guid.Empty 
                    ? "Portal asociativo para familias, educandos y scouters" 
                    : "Acceso federativo central y administración de grupos")
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="pt-2">
            <!-- Mensajes de Error Contextuales -->
            @if (HasError)
            {
                @if (Error == "wrong_tenant")
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled" Dense="true" Icon="@Icons.Material.Filled.WrongLocation">
                        Esta cuenta de usuario pertenece a otro grupo scout. Por seguridad y aislamiento multitenant, inicie sesión desde el subdominio de su propio grupo.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" Dense="true">
                        Correo electrónico o contraseña incorrectos, o usuario inactivo en este grupo.
                    </MudAlert>
                }
            }

            <!-- Formulario Estándar HTML POST hacia el endpoint /auth/login para emitir la cookie de Identity -->
            <form action="/auth/login" method="post">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <!-- Campo Correo Electrónico -->
                <div class="mb-4">
                    <label class="mud-typography mud-typography-body2" style="font-weight: 600; color: #334155; display: block; margin-bottom: 6px;">
                        Correo Electrónico
                    </label>
                    <div style="position: relative;">
                        <input type="email" 
                               name="email" 
                               required 
                               value="@DefaultEmail"
                               placeholder="@DefaultEmail" 
                               class="mud-input-slot mud-input-root mud-input-root-outlined w-100 pa-3 rounded-lg"
                               style="border: 1px solid #CBD5E1; font-family: inherit; font-size: 0.95rem; padding-left: 40px !important; transition: border-color 0.2s;" />
                        <span style="position: absolute; left: 12px; top: 12px; color: #94A3B8; pointer-events: none;">
                            <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path fill="currentColor" d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5l-8-5V6l8 5l8-5v2z"/></svg>
                        </span>
                    </div>
                </div>

                <!-- Campo Contraseña con Selector de Visibilidad -->
                <div class="mb-3">
                    <div class="d-flex align-center justify-space-between mb-1">
                        <label class="mud-typography mud-typography-body2" style="font-weight: 600; color: #334155;">
                            Contraseña
                        </label>
                    </div>
                    <div style="position: relative;">
                        <input type="@(_mostrarPassword ? "text" : "password")" 
                               name="password" 
                               required 
                               value="Scout123!"
                               placeholder="Introduce tu contraseña" 
                               class="mud-input-slot mud-input-root mud-input-root-outlined w-100 pa-3 rounded-lg"
                               style="border: 1px solid #CBD5E1; font-family: inherit; font-size: 0.95rem; padding-left: 40px !important; padding-right: 44px !important;" />
                        <span style="position: absolute; left: 12px; top: 12px; color: #94A3B8; pointer-events: none;">
                            <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path fill="currentColor" d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2s2 .9 2 2s-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2z"/></svg>
                        </span>
                        <button type="button" 
                                @onclick="() => _mostrarPassword = !_mostrarPassword"
                                style="position: absolute; right: 10px; top: 10px; background: none; border: none; cursor: pointer; color: #94A3B8;">
                            @if (_mostrarPassword)
                            {
                                <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path fill="currentColor" d="M12 7c2.76 0 5 2.24 5 5c0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.44-4.75c-1.73-4.39-6-7.5-11-7.5c-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28l.46.46A11.804 11.804 0 0 0 1 12c1.73 4.39 6 7.5 11 7.5c1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22L21 20.73L3.27 3L2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65c0 1.66 1.34 3 3 3c.22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53c-2.76 0-5-2.24-5-5c0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15l.02-.16c0-1.66-1.34-3-3-3l-.17.01z"/></svg>
                            }
                            else
                            {
                                <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5s5 2.24 5 5s-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3s3-1.34 3-3s-1.34-3-3-3z"/></svg>
                            }
                        </button>
                    </div>
                </div>

                <!-- Botón de Envío -->
                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="@(Tenant.CurrentTenantId == Guid.Empty ? Color.Secondary : Color.Primary)" 
                           FullWidth="true" 
                           Size="Size.Large"
                           Class="mt-3 py-3 rounded-lg"
                           StartIcon="@Icons.Material.Filled.Login"
                           Style="font-weight: 700; font-size: 1rem;">
                    Iniciar Sesión
                </MudButton>
            </form>

            <!-- Acceso Rápido: solo en Development (el endpoint /auth/quick-login no existe en otros entornos) -->
            @if (Entorno.IsDevelopment())
            {
            <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-5 rounded-lg" Style="border-color: #E2E8F0;">
                <MudExpansionPanel Text="Accesos Rápidos de Prueba (Entorno Local)" Icon="@Icons.Material.Filled.Speed">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-3">
                        Haga clic sobre cualquiera de los perfiles disponibles para este subdominio para iniciar sesión automáticamente:
                    </MudText>

                    @if (Tenant.TenantSlug == "sanvicente")
                    {
                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=familia.lopez@scoutssanvicente.org&returnUrl={ReturnUrl}")"
                                       StartIcon="@Icons.Material.Filled.FamilyRestroom">
                                Familia López Ruiz (San Vicente · Manada)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=scouter.tropa@scoutssanvicente.org&returnUrl={ReturnUrl}")"
                                       StartIcon="@Icons.Material.Filled.Explore">
                                David Baloo (Scouter · San Vicente)
                            </MudButton>
                        </div>
                    }
                    else if (Tenant.TenantSlug == "lestonnac")
                    {
                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=familia.garcia@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                                       StartIcon="@Icons.Material.Filled.FamilyRestroom">
                                Familia García Pérez (Lestonnac · 2 Hijos)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=scouter.manada@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                                       StartIcon="@Icons.Material.Filled.Pets">
                                Elena Akela (Scouter Manada · Lestonnac)
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=coordinador@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                                       StartIcon="@Icons.Material.Filled.Diversity3">
                                Roberto Coordinador (Kraal · Lestonnac)
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        <!-- Dominio Central / Federación -->
                        <div class="d-flex flex-column gap-2">
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Secondary" 
                                       Size="Size.Small" 
                                       Href="@($"/auth/quick-login?email=superadmin@scoutsclm.org&returnUrl=/admin/grupos")"
                                       StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                                SuperAdmin Federativo SCLM (Gestión Global)
                            </MudButton>
                        </div>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
            }
        </MudCardContent>

        <MudCardActions Class="justify-center pb-2">
            <MudLink Href="/" Typo="Typo.caption" Color="Color.Default">
                ← Volver a la portada principal
            </MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);
    private bool _mostrarPassword = false;

    private string DefaultEmail => Tenant.TenantSlug switch
    {
        "sanvicente" => "familia.lopez@scoutssanvicente.org",
        "lestonnac" => "familia.garcia@scoutslestonnac.es",
        _ => "superadmin@scoutsclm.org"
    };
}
