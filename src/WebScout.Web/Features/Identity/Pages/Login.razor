@page "/login"
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<PageTitle>Acceso a Mi Espacio · @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="d-flex align-center justify-center" Style="min-height: 80vh;">
    <MudCard Elevation="3" Class="rounded-lg w-100 pa-2" Style="border-top: 5px solid var(--mud-palette-primary); background: #FFFFFF;">
        <MudCardHeader Class="flex-column align-center text-center pb-2">
            <PanoletaSvg Config="ActivePanoleta" Width="72" Height="58" Class="mb-2" />
            <MudText Typo="Typo.h5" Style="font-weight: 800; letter-spacing: -0.01em;">
                Acceso a Mi Espacio Scout
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                @(Tenant.IsResolved ? Tenant.GroupName : "Portal Asociativo SCLM") · Grupo Nº @(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "-")
            </MudText>
        </MudCardHeader>

        <MudCardContent Class="pt-2">
            @if (HasError)
            {
                <MudAlert Severity="Severity.Error" Class="mb-4" Variant="Variant.Filled" Dense="true">
                    Credenciales no válidas para este grupo scout o cuenta desactivada.
                </MudAlert>
            }

            <!-- Formulario estándar HTML POST procesado por el endpoint /auth/login para emitir la cookie de Identity -->
            <form action="/auth/login" method="post">
                <input type="hidden" name="returnUrl" value="@ReturnUrl" />

                <div class="mb-4">
                    <label class="mud-typography mud-typography-body2" style="font-weight: 600; display: block; margin-bottom: 4px;">
                        Correo Electrónico:
                    </label>
                    <input type="email" 
                           name="email" 
                           required 
                           value="@DefaultEmail"
                           placeholder="ejemplo@scoutslestonnac.es" 
                           class="mud-input-slot mud-input-root mud-input-root-outlined w-100 pa-3 rounded"
                           style="border: 1px solid var(--mud-palette-lines-inputs); font-family: inherit; font-size: 0.95rem;" />
                </div>

                <div class="mb-4">
                    <label class="mud-typography mud-typography-body2" style="font-weight: 600; display: block; margin-bottom: 4px;">
                        Contraseña:
                    </label>
                    <input type="password" 
                           name="password" 
                           required 
                           value="Scout123!"
                           placeholder="••••••••" 
                           class="mud-input-slot mud-input-root mud-input-root-outlined w-100 pa-3 rounded"
                           style="border: 1px solid var(--mud-palette-lines-inputs); font-family: inherit; font-size: 0.95rem;" />
                </div>

                <MudButton ButtonType="ButtonType.Submit" 
                           Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           FullWidth="true" 
                           Size="Size.Large"
                           Class="mt-2 py-3"
                           StartIcon="@Icons.Material.Filled.Login">
                    Iniciar Sesión
                </MudButton>
            </form>

            <MudDivider Class="my-5" />

            <!-- Selector de Acceso Rápido para Pruebas en Desarrollo -->
            <MudText Typo="Typo.caption" Class="d-block text-center mud-text-secondary mb-2" Style="font-weight: 700; text-transform: uppercase;">
                Acceso Rápido de Prueba (Entorno Local):
            </MudText>

            @if (Tenant.TenantSlug == "sanvicente")
            {
                <div class="d-flex flex-column gap-2">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small" 
                               Href="@($"/auth/quick-login?email=familia.lopez@scoutssanvicente.org&returnUrl={ReturnUrl}")"
                               StartIcon="@Icons.Material.Filled.FamilyRestroom">
                        Familia López Ruiz (San Vicente)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small" 
                               Href="@($"/auth/quick-login?email=scouter.tropa@scoutssanvicente.org&returnUrl={ReturnUrl}")"
                               StartIcon="@Icons.Material.Filled.Explore">
                        David Baloo (Scouter Tropa · San Vicente)
                    </MudButton>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-2">
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small" 
                               Href="@($"/auth/quick-login?email=familia.garcia@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                               StartIcon="@Icons.Material.Filled.FamilyRestroom">
                        Familia García Pérez (Lestonnac)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small" 
                               Href="@($"/auth/quick-login?email=scouter.manada@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                               StartIcon="@Icons.Material.Filled.Pets">
                        Elena Akela (Scouter Manada · Lestonnac)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small" 
                               Href="@($"/auth/quick-login?email=coordinador@scoutslestonnac.es&returnUrl={ReturnUrl}")"
                               StartIcon="@Icons.Material.Filled.AdminPanelSettings">
                        Roberto Coordinador (Lestonnac)
                    </MudButton>
                </div>
            }
        </MudCardContent>

        <MudCardActions Class="justify-center pb-4">
            <MudLink Href="/" Typo="Typo.caption" Color="Color.Default">
                ← Volver a la portada pública
            </MudLink>
        </MudCardActions>
    </MudCard>
</MudContainer>

@code {
    [SupplyParameterFromQuery]
    public string? Error { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);

    private string DefaultEmail => Tenant.TenantSlug switch
    {
        "sanvicente" => "familia.lopez@scoutssanvicente.org",
        _ => "familia.garcia@scoutslestonnac.es"
    };

    private PanoletaConfig ActivePanoleta => Tenant.TenantSlug switch
    {
        "sanvicente" => PanoletaConfig.SanVicente412,
        _ => PanoletaConfig.Lestonnac330
    };
}
