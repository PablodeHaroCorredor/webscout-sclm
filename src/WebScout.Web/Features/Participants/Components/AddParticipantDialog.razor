@inject IParticipantService ParticipantService
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Registrar Nuevo Educando</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Añada un nuevo hijo o menor bajo su tutela. Podrá cumplimentar su Ficha Médica completa una vez creado.
        </MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_firstName" Label="Nombre *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_lastName" Label="Apellidos *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_birthDate" Label="Fecha de Nacimiento *" Variant="Variant.Outlined" Editable="true" MaxDate="DateTime.Today" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_branch" Label="Rama / Sección *" Variant="Variant.Outlined">
                    <MudSelectItem Value="ScoutBranch.Castores">Castores (6-8 años)</MudSelectItem>
                    <MudSelectItem Value="ScoutBranch.Manada">Manada (8-11 años)</MudSelectItem>
                    <MudSelectItem Value="ScoutBranch.Tropa">Tropa (11-14 años)</MudSelectItem>
                    <MudSelectItem Value="ScoutBranch.Escultas">Escultas (14-17 años)</MudSelectItem>
                    <MudSelectItem Value="ScoutBranch.Clan">Clan Rover (17-21 años)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_dni" Label="DNI / NIE (Opcional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_gender" Label="Sexo" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Femenino")">Femenino</MudSelectItem>
                    <MudSelectItem Value="@("Masculino")">Masculino</MudSelectItem>
                    <MudSelectItem Value="@("Otro")">Otro</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_cip" Label="CIP / Nº Tarjeta Sanitaria *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_emergencyPhone" Label="Teléfono de Emergencia *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_saving">
            @if (_saving)
            {
                <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar Educando</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid LegalGuardianId { get; set; }

    [Parameter]
    public Guid OrganizationId { get; set; }

    private string _firstName = "";
    private string _lastName = "";
    private DateTime? _birthDate = DateTime.Today.AddYears(-9);
    private ScoutBranch _branch = ScoutBranch.Manada;
    private string? _dni;
    private string _gender = "Femenino";
    private string _cip = "";
    private string _emergencyPhone = "";
    private bool _saving;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName) || !_birthDate.HasValue ||
            string.IsNullOrWhiteSpace(_cip) || string.IsNullOrWhiteSpace(_emergencyPhone))
        {
            Snackbar.Add("Por favor complete los campos obligatorios (*).", Severity.Warning);
            return;
        }

        try
        {
            _saving = true;

            var participant = new ScoutParticipant
            {
                Id = Guid.NewGuid(),
                OrganizationId = OrganizationId,
                LegalGuardianId = LegalGuardianId,
                FirstName = _firstName.Trim(),
                LastName = _lastName.Trim(),
                BirthDate = DateOnly.FromDateTime(_birthDate.Value),
                Dni = _dni?.Trim(),
                Gender = _gender,
                CurrentBranch = _branch,
                IsActive = true,
                CreatedAtUtc = DateTime.UtcNow
            };

            var healthRecord = new ParticipantHealthRecord
            {
                OrganizationId = OrganizationId,
                HealthInsuranceNumber = _cip.Trim(),
                PrimaryEmergencyPhone = _emergencyPhone.Trim(),
                CanSwim = true,
                VaccinationsUpToDate = true
            };

            var created = await ParticipantService.CreateParticipantAsync(participant, healthRecord);
            Snackbar.Add($"Educando {created.FullName} registrado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(created));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar el educando: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
