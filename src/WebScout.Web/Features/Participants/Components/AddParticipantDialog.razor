@inject IServicioEducandos ServicioEducandos
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Registrar Nuevo Educando</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Añada un nuevo menor bajo su tutela. Podrá cumplimentar su Ficha Médica completa una vez registrado.
        </MudText>

        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_nombre" Label="Nombre *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_apellidos" Label="Apellidos *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_fechaNacimiento" Label="Fecha de Nacimiento *" Variant="Variant.Outlined" Editable="true" MaxDate="DateTime.Today" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_rama" Label="Rama / Sección *" Variant="Variant.Outlined">
                    <MudSelectItem Value="RamaScout.Castores">Castores (6-8 años)</MudSelectItem>
                    <MudSelectItem Value="RamaScout.Manada">Manada (8-11 años)</MudSelectItem>
                    <MudSelectItem Value="RamaScout.Tropa">Tropa (11-14 años)</MudSelectItem>
                    <MudSelectItem Value="RamaScout.Escultas">Escultas (14-17 años)</MudSelectItem>
                    <MudSelectItem Value="RamaScout.Clan">Clan Rover (17-21 años)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_dni" Label="DNI / NIE (Opcional)" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect @bind-Value="_sexo" Label="Sexo" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Femenino")">Femenino</MudSelectItem>
                    <MudSelectItem Value="@("Masculino")">Masculino</MudSelectItem>
                    <MudSelectItem Value="@("Otro")">Otro</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_cip" Label="CIP / Nº Tarjeta Sanitaria *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_telefonoEmergencia" Label="Teléfono de Emergencia *" Variant="Variant.Outlined" Required="true" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="_guardando">
            @if (_guardando)
            {
                <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                <span>Guardando...</span>
            }
            else
            {
                <span>Guardar Educando</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid TutorLegalId { get; set; }

    [Parameter]
    public Guid OrganizacionId { get; set; }

    private string _nombre = "";
    private string _apellidos = "";
    private DateTime? _fechaNacimiento = DateTime.Today.AddYears(-9);
    private RamaScout _rama = RamaScout.Manada;
    private string? _dni;
    private string _sexo = "Femenino";
    private string _cip = "";
    private string _telefonoEmergencia = "";
    private bool _guardando;

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombre) || string.IsNullOrWhiteSpace(_apellidos) || !_fechaNacimiento.HasValue ||
            string.IsNullOrWhiteSpace(_cip) || string.IsNullOrWhiteSpace(_telefonoEmergencia))
        {
            Snackbar.Add("Por favor complete los campos obligatorios (*).", Severity.Warning);
            return;
        }

        try
        {
            _guardando = true;

            var educando = new Educando
            {
                Id = Guid.NewGuid(),
                OrganizacionId = OrganizacionId,
                TutorLegalId = TutorLegalId,
                Nombre = _nombre.Trim(),
                Apellidos = _apellidos.Trim(),
                FechaNacimiento = DateOnly.FromDateTime(_fechaNacimiento.Value),
                Dni = _dni?.Trim(),
                Sexo = _sexo,
                RamaActual = _rama,
                Activo = true,
                FechaCreacionUtc = DateTime.UtcNow
            };

            var fichaMedica = new FichaMedica
            {
                OrganizacionId = OrganizacionId,
                NumeroSeguridadSocial = _cip.Trim(),
                TelefonoEmergenciaPrincipal = _telefonoEmergencia.Trim(),
                SabeNadar = true,
                VacunacionAlDia = true
            };

            var creado = await ServicioEducandos.CrearEducandoAsync(educando, fichaMedica);
            Snackbar.Add($"Educando {creado.NombreCompleto} registrado correctamente.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(creado));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al registrar el educando: {ex.Message}", Severity.Error);
        }
        finally
        {
            _guardando = false;
        }
    }
}
