@using MudBlazor
@using WebScout.Web.Features.Participants.Domain

<MudDialog ContentClass="scout-dialog-scrollable">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonOff" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Dar de baja</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 text-secondary">
            @Educando?.NombreCompleto dejará de aparecer en el censo activo de la sección. No se borra ningún dato y podrás reactivarlo desde «Ver bajas».
        </MudText>
        <MudTextField @bind-Value="_motivo" Label="Motivo de la baja (obligatorio)" Variant="Variant.Outlined"
                      Lines="3" MaxLength="500" Required="true"
                      Placeholder="Ejemplo: La familia comunica que deja el grupo al final de la ronda." />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default">Cancelar</MudButton>
        <MudButton OnClick="Confirmar" Variant="Variant.Filled" Color="Color.Warning"
                   Disabled="@string.IsNullOrWhiteSpace(_motivo)" StartIcon="@Icons.Material.Filled.PersonOff">
            Dar de baja
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Educando? Educando { get; set; }

    private string _motivo = string.Empty;

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar()
    {
        if (!string.IsNullOrWhiteSpace(_motivo))
        {
            MudDialog.Close(DialogResult.Ok(_motivo.Trim()));
        }
    }
}
