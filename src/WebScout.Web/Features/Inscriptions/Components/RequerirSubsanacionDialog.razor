@using MudBlazor
@using WebScout.Web.Features.Inscriptions.Domain

<MudDialog ContentClass="scout-dialog-scrollable">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">Requerir Subsanación de Justificante</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 text-secondary">
            Indique a la familia el motivo por el cual el justificante bancario o la documentación presentada requiere ser corregida o sustituida. Esta nota se registrará en el expediente y se notificará por correo a la familia.
        </MudText>

        @if (Inscripcion != null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mb-4 rounded-lg" Style="background-color: #FFFBEB; border-color: #FDE68A;">
                <div class="d-flex justify-space-between align-center mb-1">
                    <span style="font-weight: 700; color: #92400E;">Educando:</span>
                    <span style="color: #78350F;">@Inscripcion.Educando?.NombreCompleto (@Inscripcion.Educando?.RamaActual.ObtenerNombre())</span>
                </div>
                <div class="d-flex justify-space-between align-center mb-1">
                    <span style="font-weight: 700; color: #92400E;">Actividad:</span>
                    <span style="color: #78350F;">@Inscripcion.Actividad?.Titulo</span>
                </div>
                <div class="d-flex justify-space-between align-center">
                    <span style="font-weight: 700; color: #92400E;">Importe Exigido:</span>
                    <span style="font-weight: 700; color: #78350F;">@Inscripcion.ImporteEuros.ToString("C2")</span>
                </div>
            </MudPaper>
        }

        <MudTextField @bind-Value="_motivoSubsanacion"
                      Label="Motivo de la subsanación (obligatorio)"
                      Variant="Variant.Outlined"
                      Lines="4"
                      Required="true"
                      RequiredError="Debe indicar un motivo claro para que la familia pueda subsanar el error."
                      Placeholder="Ejemplo: El justificante adjunto no especifica el nombre del menor en el concepto bancario, o el importe transferido (20€) es inferior a la cuota establecida (35€)."
                      Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Variant="Variant.Text" Color="Color.Default" Disabled="_guardando">Cancelar</MudButton>
        <MudButton OnClick="ConfirmarSubsanacion" 
                   Variant="Variant.Filled" 
                   Color="Color.Warning" 
                   Disabled="@(string.IsNullOrWhiteSpace(_motivoSubsanacion) || _guardando)"
                   StartIcon="@(_guardando ? null : Icons.Material.Filled.Send)">
            @if (_guardando)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ms-n1 me-2" />
                <span>Solicitando...</span>
            }
            else
            {
                <span>Solicitar Subsanación</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public InscripcionActividad? Inscripcion { get; set; }

    private string _motivoSubsanacion = string.Empty;
    private bool _guardando = false;

    private void Cancelar() => MudDialog.Cancel();

    private void ConfirmarSubsanacion()
    {
        if (!string.IsNullOrWhiteSpace(_motivoSubsanacion))
        {
            _guardando = true;
            MudDialog.Close(DialogResult.Ok(_motivoSubsanacion.Trim()));
        }
    }
}
