@page "/familias/inscripciones"
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using System.Globalization
@using WebScout.Web.Features.Inscriptions.Domain
@using WebScout.Web.Features.Inscriptions.Services
@using WebScout.Web.Features.Inscriptions.Components
@attribute [Authorize(Roles = $"{RolesScout.Familia},{RolesScout.Scouter},{RolesScout.Coordinacion},{RolesScout.Administracion}")]
@inject IServicioInscripciones ServicioInscripciones
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject ITenantContext Tenant

<PageTitle>Mis Inscripciones — WebScout SCLM</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
        <div>
            <MudText Typo="Typo.h5" Style="font-weight: 700;">Mis Inscripciones y Justificantes</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Seguimiento de autorizaciones, plazas y comprobantes bancarios en @(Tenant.IsResolved ? Tenant.GroupName : "el grupo scout").
            </MudText>
        </div>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.EventAvailable" 
                   Href="/familias/actividades">
            Ver Próximas Actividades
        </MudButton>
    </div>

    @if (_cargando)
    {
        <div class="d-flex justify-center align-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (_inscripciones.Count == 0)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Size="Size.Large" Color="Color.Default" Class="mb-3" />
            <MudText Typo="Typo.h6">No tienes inscripciones activas</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                Consulta las actividades y campamentos disponibles para tu familia e inscribe a tus hijos.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/familias/actividades">
                Explorar Actividades Convocadas
            </MudButton>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_inscripciones" Dense="true" Hover="true" Elevation="0" Outlined="true">
            <HeaderContent>
                <MudTh>Educando</MudTh>
                <MudTh>Actividad y Fechas</MudTh>
                <MudTh>Cuota</MudTh>
                <MudTh>Estado Tramitación</MudTh>
                <MudTh>Justificante de Pago</MudTh>
                <MudTh Class="text-end">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Educando">
                    <MudText Typo="Typo.body2" Style="font-weight: 700;">@context.Educando.NombreCompleto</MudText>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                        Rama @context.Educando.RamaActual.ObtenerNombre()
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actividad">
                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Actividad.Titulo</MudText>
                    <div class="d-flex align-center gap-1 mud-text-secondary">
                        <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small" Style="font-size: 0.85rem;" />
                        <MudText Typo="Typo.caption">@context.Actividad.Lugar</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @context.Actividad.FechaInicio.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Cuota">
                    <MudText Typo="Typo.body2" Style="font-weight: 700;">
                        @(context.ImporteEuros == 0 ? "Gratuita" : $"{context.ImporteEuros:N2} €")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Estado">
                    <MudChip T="string" Size="Size.Small" Color="@ObtenerColorEstado(context.Estado)" Variant="Variant.Filled">
                        @ObtenerNombreEstado(context.Estado)
                    </MudChip>
                    @if (context.Estado == EstadoInscripcion.RequiereSubsanacion && !string.IsNullOrWhiteSpace(context.NotasKraal))
                    {
                        <MudText Typo="Typo.caption" Class="d-block text-danger mt-1">
                            Aviso Kraal: @context.NotasKraal
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Justificante">
                    @if (context.TieneJustificanteSubido)
                    {
                        <div class="d-flex align-center gap-2">
                            <MudButton Variant="Variant.Outlined" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       Href="@($"/api/justificantes/{context.Id}")" 
                                       Target="_blank"
                                       StartIcon="@Icons.Material.Filled.Download">
                                Ver
                            </MudButton>
                            @if (context.Estado != EstadoInscripcion.Confirmada && context.Estado != EstadoInscripcion.Cancelada)
                            {
                                <MudButton Variant="Variant.Text" 
                                           Color="Color.Default" 
                                           Size="Size.Small" 
                                           OnClick="@(() => AbrirDialogoJustificanteAsync(context))">
                                    Reemplazar
                                </MudButton>
                            }
                        </div>
                    }
                    else if (context.ImporteEuros == 0)
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">No requerido</MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" 
                                   Color="Color.Warning" 
                                   Size="Size.Small" 
                                   StartIcon="@Icons.Material.Filled.UploadFile"
                                   OnClick="@(() => AbrirDialogoJustificanteAsync(context))">
                            Subir Justificante
                        </MudButton>
                    }
                </MudTd>
                <MudTd DataLabel="Acciones" Class="text-end">
                    @if (context.Estado != EstadoInscripcion.Cancelada && context.Actividad.FechaInicio > DateTime.UtcNow)
                    {
                        <MudButton Variant="Variant.Text" 
                                   Color="Color.Error" 
                                   Size="Size.Small" 
                                   OnClick="@(() => CancelarInscripcionAsync(context))">
                            Anular
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudContainer>

@code {
    private List<InscripcionActividad> _inscripciones = [];
    private bool _cargando = true;
    private Guid _usuarioActualId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (Guid.TryParse(userIdStr, out var id))
            {
                _usuarioActualId = id;
            }
        }

        await CargarInscripcionesAsync();
    }

    private async Task CargarInscripcionesAsync()
    {
        if (_usuarioActualId == Guid.Empty)
        {
            _cargando = false;
            return;
        }

        _cargando = true;
        try
        {
            var res = await ServicioInscripciones.ObtenerInscripcionesFamiliaAsync(_usuarioActualId);
            _inscripciones = res.ToList();
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task AbrirDialogoJustificanteAsync(InscripcionActividad inscripcion)
    {
        var parameters = new DialogParameters<SubirJustificanteDialog>
        {
            { x => x.Inscripcion, inscripcion }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<SubirJustificanteDialog>("Justificante Bancario", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await CargarInscripcionesAsync();
        }
    }

    private async Task CancelarInscripcionAsync(InscripcionActividad inscripcion)
    {
        var confirmacion = await DialogService.ShowMessageBoxAsync(
            "Anular Inscripción",
            $"¿Estás seguro de que deseas anular la inscripción de {inscripcion.Educando.Nombre} a '{inscripcion.Actividad.Titulo}'?",
            yesText: "Sí, Anular",
            cancelText: "No");

        if (confirmacion == true)
        {
            try
            {
                await ServicioInscripciones.CancelarInscripcionAsync(inscripcion.Id, _usuarioActualId);
                Snackbar.Add("Inscripción anulada correctamente.", Severity.Info);
                await CargarInscripcionesAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error al anular: {ex.Message}", Severity.Error);
            }
        }
    }

    private Color ObtenerColorEstado(EstadoInscripcion estado) => estado switch
    {
        EstadoInscripcion.PendienteJustificante => Color.Warning,
        EstadoInscripcion.EnRevision => Color.Info,
        EstadoInscripcion.Confirmada => Color.Success,
        EstadoInscripcion.RequiereSubsanacion => Color.Error,
        EstadoInscripcion.Cancelada => Color.Default,
        _ => Color.Default
    };

    private string ObtenerNombreEstado(EstadoInscripcion estado) => estado switch
    {
        EstadoInscripcion.PendienteJustificante => "Pendiente Justificante",
        EstadoInscripcion.EnRevision => "En Revisión por Kraal",
        EstadoInscripcion.Confirmada => "Plaza Confirmada",
        EstadoInscripcion.RequiereSubsanacion => "Requiere Subsanación",
        EstadoInscripcion.Cancelada => "Cancelada",
        _ => estado.ToString()
    };
}
