@page "/administracion/outbox"
@using Microsoft.AspNetCore.Authorization
@using WebScout.Web.Infrastructure.Outbox.Domain
@using WebScout.Web.Infrastructure.Outbox.Services
@using WebScout.Web.Infrastructure.Tenancy
@attribute [Authorize(Roles = RolesScout.AreaSupervision)]
@inject IServicioOutbox ServicioOutbox
@inject ITenantContext Tenant
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Monitor de Salida Outbox · @(Tenant.GroupName)</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <!-- Encabezado de la página -->
    <div class="d-flex flex-wrap justify-space-between align-center gap-4 mb-6">
        <div>
            <div class="d-flex align-center gap-2 mb-2">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                    @(Tenant.GroupName)
                </MudChip>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0F172A; letter-spacing: -0.02em;">
                Monitor de Cola de Salida (Outbox)
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                Supervisión del envío de correos electrónicos a familias y scouters, historial de entrega y reintentos ante incidencias.
            </MudText>
        </div>

        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Default" 
                       StartIcon="@Icons.Material.Filled.Refresh" 
                       Disabled="_cargando"
                       OnClick="CargarDatosAsync">
                Actualizar
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Send" 
                       Disabled="_procesando"
                       OnClick="DespacharLoteAsync">
                @if (_procesando)
                {
                    <span>Despachando...</span>
                }
                else
                {
                    <span>Despachar Cola @((_resumen?.Pendientes ?? 0) > 0 ? $"({_resumen?.Pendientes})" : "")</span>
                }
            </MudButton>
        </div>
    </div>

    <!-- TARJETAS DE MÉTRICAS QUE ACTÚAN DIRECTAMENTE COMO SELECTOR DE FILTRO -->
    <MudGrid Spacing="3" Class="mb-6">
        <!-- 1. Total Registrados -->
        <MudItem xs="12" sm="6" md="3">
            <div class="rounded-2xl border bg-white pa-5 h-100 cursor-pointer stat-card position-relative"
                 style="@(_filtroEstado == null 
                     ? "border-color: #2563EB !important; box-shadow: 0 0 0 1px #2563EB, 0 4px 6px -1px rgba(37, 99, 235, 0.1); background-color: #F8FAFC !important;" 
                     : "border-color: #E2E8F0;")"
                 @onclick="@(() => OnSeleccionarFiltro(null))">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <div class="d-flex align-center gap-1.5 mb-1">
                            <span class="active-dot" style="@(_filtroEstado == null ? "background-color: #2563EB;" : "background-color: transparent;")"></span>
                            <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.72rem;">
                                Todos los Correos
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0F172A; margin-top: 2px; line-height: 1.1;">
                            @(_resumen?.TotalMensajes ?? 0)
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block" Style="font-size: 0.75rem;">
                            Registrados en la plataforma
                        </MudText>
                    </div>
                    <div style="background-color: #EFF6FF; color: #2563EB; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.AllInbox" Size="Size.Medium" />
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- 2. Pendientes en Cola -->
        <MudItem xs="12" sm="6" md="3">
            <div class="rounded-2xl border bg-white pa-5 h-100 cursor-pointer stat-card position-relative"
                 style="@(_filtroEstado == EstadoMensajeOutbox.Pendiente 
                     ? "border-color: #D97706 !important; box-shadow: 0 0 0 1px #D97706, 0 4px 6px -1px rgba(217, 119, 6, 0.1); background-color: #FFFBEB !important;" 
                     : "border-color: #E2E8F0;")"
                 @onclick="@(() => OnSeleccionarFiltro(EstadoMensajeOutbox.Pendiente))">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <div class="d-flex align-center gap-1.5 mb-1">
                            <span class="active-dot" style="@(_filtroEstado == EstadoMensajeOutbox.Pendiente ? "background-color: #D97706;" : "background-color: transparent;")"></span>
                            <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.72rem;">
                                Pendientes en Cola
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #D97706; margin-top: 2px; line-height: 1.1;">
                            @(_resumen?.Pendientes ?? 0)
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block" Style="font-size: 0.75rem;">
                            Listos para ser enviados
                        </MudText>
                    </div>
                    <div style="background-color: #FFFBEB; color: #D97706; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Size="Size.Medium" />
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- 3. Enviados con Éxito -->
        <MudItem xs="12" sm="6" md="3">
            <div class="rounded-2xl border bg-white pa-5 h-100 cursor-pointer stat-card position-relative"
                 style="@(_filtroEstado == EstadoMensajeOutbox.Enviado 
                     ? "border-color: #059669 !important; box-shadow: 0 0 0 1px #059669, 0 4px 6px -1px rgba(5, 150, 105, 0.1); background-color: #ECFDF5 !important;" 
                     : "border-color: #E2E8F0;")"
                 @onclick="@(() => OnSeleccionarFiltro(EstadoMensajeOutbox.Enviado))">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <div class="d-flex align-center gap-1.5 mb-1">
                            <span class="active-dot" style="@(_filtroEstado == EstadoMensajeOutbox.Enviado ? "background-color: #059669;" : "background-color: transparent;")"></span>
                            <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.72rem;">
                                Enviados con Éxito
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #059669; margin-top: 2px; line-height: 1.1;">
                            @(_resumen?.Enviados ?? 0)
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block" Style="font-size: 0.75rem;">
                            Entregados al servidor SMTP
                        </MudText>
                    </div>
                    <div style="background-color: #ECFDF5; color: #059669; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Size="Size.Medium" />
                    </div>
                </div>
            </div>
        </MudItem>

        <!-- 4. Reintentos / Fallidos -->
        <MudItem xs="12" sm="6" md="3">
            <div class="rounded-2xl border bg-white pa-5 h-100 cursor-pointer stat-card position-relative"
                 style="@(_filtroEstado == EstadoMensajeOutbox.Fallido 
                     ? "border-color: #DC2626 !important; box-shadow: 0 0 0 1px #DC2626, 0 4px 6px -1px rgba(220, 38, 38, 0.1); background-color: #FEF2F2 !important;" 
                     : "border-color: #E2E8F0;")"
                 @onclick="@(() => OnSeleccionarFiltro(EstadoMensajeOutbox.Fallido))">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <div class="d-flex align-center gap-1.5 mb-1">
                            <span class="active-dot" style="@(_filtroEstado == EstadoMensajeOutbox.Fallido ? "background-color: #DC2626;" : "background-color: transparent;")"></span>
                            <MudText Typo="Typo.caption" Style="color: #64748B; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; font-size: 0.72rem;">
                                Incidencias / Fallidos
                            </MudText>
                        </div>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #DC2626; margin-top: 2px; line-height: 1.1;">
                            @((_resumen?.EnReintento ?? 0) + (_resumen?.Fallidos ?? 0))
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-1 d-block" Style="font-size: 0.75rem;">
                            Con fallo en el último intento
                        </MudText>
                    </div>
                    <div style="background-color: #FEF2F2; color: #DC2626; width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Medium" />
                    </div>
                </div>
            </div>
        </MudItem>
    </MudGrid>

    <!-- TABLA DE MENSAJES CON BARRA DE BÚSQUEDA INTEGRADA EN SU CABECERA -->
    <MudCard Elevation="0" Outlined="true" Class="rounded-2xl border bg-white overflow-hidden">
        <!-- Barra de herramientas limpia integrada -->
        <div class="d-flex flex-wrap justify-space-between align-center gap-3 px-5 py-3 border-b" style="border-bottom: 1px solid #E2E8F0; background-color: #FAFAFA;">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0F172A;">
                    @ObtenerTituloVistaFiltro()
                </MudText>
                @if (_filtroEstado != null || !string.IsNullOrWhiteSpace(_busqueda))
                {
                    <MudChip T="string" 
                             Size="Size.Small" 
                             Color="Color.Default" 
                             Variant="Variant.Text" 
                             OnClose="RestablecerFiltrosAsync">
                        Ver todos
                    </MudChip>
                }
            </div>

            <!-- Búsqueda rápida integrada -->
            <div style="min-width: 260px; max-width: 420px; flex-grow: 1;">
                <MudTextField T="string" 
                              Placeholder="Buscar por asunto, destinatario o correo..." 
                              @bind-Value="_busqueda" 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Clearable="true"
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="CargarDatosAsync" />
            </div>
        </div>

        @if (_cargando)
        {
            <div class="d-flex flex-column align-center justify-center py-12 gap-3">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Cargando mensajes del Outbox...</MudText>
            </div>
        }
        else if (_mensajes.Count == 0)
        {
            <div class="d-flex flex-column align-center justify-center py-12 px-4 text-center">
                <MudAvatar Color="Color.Default" Variant="Variant.Outlined" Size="Size.Large" Class="mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.Inbox" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #0F172A;">
                    No se encontraron mensajes
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary" Style="max-width: 400px;">
                    No hay correos en la cola con el filtro seleccionado o el término de búsqueda actual.
                </MudText>
            </div>
        }
        else
        {
            <MudTable Items="@_mensajes" 
                      Hover="true" 
                      Dense="false" 
                      Elevation="0"
                      FixedHeader="true"
                      Height="540px"
                      RowsPerPage="25">
                <HeaderContent>
                    <MudTh Style="width: 170px;">Fecha y Hora</MudTh>
                    <MudTh Style="min-width: 200px;">Destinatario</MudTh>
                    <MudTh Style="min-width: 240px;">Asunto y Tipo</MudTh>
                    <MudTh Style="width: 130px; text-align: center;">Estado</MudTh>
                    <MudTh Style="width: 90px; text-align: center;">Intentos</MudTh>
                    <MudTh Style="min-width: 180px;">Resultado / Entrega</MudTh>
                    <MudTh Style="width: 140px; text-align: right;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Fecha">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: #0F172A;">
                            @context.FechaCreacionUtc.AHoraEspana().ToString("dd/MM/yyyy")
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @context.FechaCreacionUtc.AHoraEspana().ToString("HH:mm:ss")
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Destinatario">
                        <MudText Typo="Typo.body2" Style="font-weight: 700; color: #0F172A;">
                            @context.DestinatarioNombre
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block">
                            @context.DestinatarioEmail
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Asunto">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; color: #0F172A;">
                            @context.Asunto
                        </MudText>
                        <div class="mt-1">
                            <span class="px-2 py-0.5 rounded text-xs" style="background-color: #F1F5F9; color: #475569; font-size: 0.72rem; font-weight: 600;">
                                @FormatearTipoEvento(context.TipoEvento)
                            </span>
                        </div>
                    </MudTd>

                    <MudTd DataLabel="Estado" Style="text-align: center;">
                        <span class="px-2.5 py-1 rounded-pill" style="@ObtenerEstiloPillEstado(context.Estado)">
                            @context.Estado.ToString()
                        </span>
                    </MudTd>

                    <MudTd DataLabel="Intentos" Style="text-align: center;">
                        <MudText Typo="Typo.body2" Style="@(context.Reintentos > 0 ? "font-weight: 700; color: #D97706;" : "color: #64748B;")">
                            @context.Reintentos / @context.MaxReintentos
                        </MudText>
                    </MudTd>

                    <MudTd DataLabel="Resultado">
                        @if (!string.IsNullOrWhiteSpace(context.ErrorUltimoReintento))
                        {
                            <MudTooltip Text="@context.ErrorUltimoReintento">
                                <div class="d-flex align-center gap-1" style="color: #DC2626;">
                                    <MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" />
                                    <MudText Typo="Typo.caption" Class="text-truncate" Style="font-weight: 600; max-width: 220px;">
                                        @context.ErrorUltimoReintento
                                    </MudText>
                                </div>
                            </MudTooltip>
                        }
                        else if (context.FechaProcesadoUtc.HasValue)
                        {
                            <div class="d-flex align-center gap-1" style="color: #059669;">
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                                <MudText Typo="Typo.caption" Style="font-weight: 600;">
                                    Entregado @context.FechaProcesadoUtc.Value.AHoraEspana().ToString("dd/MM HH:mm")
                                </MudText>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                En cola de salida
                            </MudText>
                        }
                    </MudTd>

                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <div class="d-flex align-center justify-end gap-1">
                            <MudTooltip Text="Ver contenido del correo">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                               Size="Size.Small" 
                                               Color="Color.Default" 
                                               aria-label="Ver contenido del correo"
                                               OnClick="@(() => VerDetalleMensaje(context))" />
                            </MudTooltip>

                            @if (context.Estado == EstadoMensajeOutbox.Fallido)
                            {
                                <MudTooltip Text="Forzar reintento">
                                    <MudIconButton Icon="@Icons.Material.Filled.Replay" 
                                                   Size="Size.Small" 
                                                   Color="Color.Warning" 
                                                   aria-label="@($"Reintentar envío a {context.DestinatarioEmail}")"
                                                   OnClick="@(() => ReintentarMensajeAsync(context))" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }"
                                   RowsPerPageString="Filas por página:"
                                   InfoFormat="{first_item}-{last_item} de {all_items}" />
                </PagerContent>
            </MudTable>
        }
    </MudCard>
</MudContainer>

<style>
    .stat-card {
        transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
    }
    .stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px rgba(0, 0, 0, 0.025);
    }
    .active-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        transition: background-color 0.2s ease;
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>

@code {
    private bool _cargando = true;
    private bool _procesando = false;
    private ResumenOutboxDto? _resumen;
    private IReadOnlyList<MensajeOutbox> _mensajes = [];

    private string? _busqueda;
    private EstadoMensajeOutbox? _filtroEstado;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        _cargando = true;
        try
        {
            _resumen = await ServicioOutbox.ObtenerResumenEstadisticasAsync();
            _mensajes = await ServicioOutbox.ObtenerMensajesAsync(_filtroEstado, _busqueda);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnSeleccionarFiltro(EstadoMensajeOutbox? estado)
    {
        _filtroEstado = estado;
        await CargarDatosAsync();
    }

    private async Task RestablecerFiltrosAsync()
    {
        _filtroEstado = null;
        _busqueda = null;
        await CargarDatosAsync();
    }

    private string ObtenerTituloVistaFiltro() => _filtroEstado switch
    {
        EstadoMensajeOutbox.Pendiente => $"Correos Pendientes en Cola ({_mensajes.Count})",
        EstadoMensajeOutbox.Enviado => $"Correos Enviados con Éxito ({_mensajes.Count})",
        EstadoMensajeOutbox.Fallido => $"Correos con Incidencias o Fallidos ({_mensajes.Count})",
        _ => $"Todos los Correos ({_mensajes.Count})"
    };

    private async Task DespacharLoteAsync()
    {
        _procesando = true;
        try
        {
            var despachados = await ServicioOutbox.ProcesarLotePendienteAsync();
            Snackbar.Add($"Lote procesado: {despachados} mensajes enviados con éxito.", Severity.Success);
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task ReintentarMensajeAsync(MensajeOutbox mensaje)
    {
        bool? confirmar = await DialogService.ShowMessageBoxAsync(
            "Reintentar envío",
            $"Se volverá a enviar «{mensaje.Asunto}» a {mensaje.DestinatarioEmail}.",
            yesText: "Reintentar envío",
            cancelText: "Volver");

        if (confirmar != true) return;

        try
        {
            await ServicioOutbox.ReintentarMensajeAsync(mensaje.Id);
            Snackbar.Add("Mensaje restablecido en cola para despacho inmediato.", Severity.Info);
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task VerDetalleMensaje(MensajeOutbox mensaje)
    {
        var parameters = new DialogParameters<VerMensajeOutboxDialog>
        {
            { x => x.Mensaje, mensaje }
        };

        await DialogService.ShowAsync<VerMensajeOutboxDialog>(
            "Detalle del Correo",
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private string FormatearTipoEvento(string tipoEvento) => tipoEvento switch
    {
        "BienvenidaAltaEducandoCenso" => "Alta en Censo Familiar",
        "InscripcionSubsanacionRequerida" => "Subsanación de Justificante",
        "SolicitudAdmisionPresentada" => "Acuse de Solicitud de Admisión",
        "ConfirmacionInscripcion" => "Plaza Confirmada",
        _ => tipoEvento
    };

    private string ObtenerEstiloPillEstado(EstadoMensajeOutbox estado) => estado switch
    {
        EstadoMensajeOutbox.Enviado => "background-color: #ECFDF5; color: #065F46; font-weight: 700; font-size: 0.75rem; border: 1px solid #A7F3D0;",
        EstadoMensajeOutbox.Pendiente => "background-color: #FFFBEB; color: #92400E; font-weight: 700; font-size: 0.75rem; border: 1px solid #FDE68A;",
        EstadoMensajeOutbox.EnProceso => "background-color: #EFF6FF; color: #1E40AF; font-weight: 700; font-size: 0.75rem; border: 1px solid #BFDBFE;",
        EstadoMensajeOutbox.Fallido => "background-color: #FEF2F2; color: #991B1B; font-weight: 700; font-size: 0.75rem; border: 1px solid #FECACA;",
        _ => "background-color: #F1F5F9; color: #475569; font-weight: 700; font-size: 0.75rem;"
    };
}
