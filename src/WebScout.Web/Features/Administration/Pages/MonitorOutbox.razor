@page "/administracion/outbox"
@using Microsoft.AspNetCore.Authorization
@using WebScout.Web.Infrastructure.Outbox.Domain
@using WebScout.Web.Infrastructure.Outbox.Services
@using WebScout.Web.Infrastructure.Tenancy
@attribute [Authorize(Roles = "Coordinacion,Administracion,SuperAdmin")]
@inject IServicioOutbox ServicioOutbox
@inject ITenantContext Tenant
@inject ISnackbar Snackbar

<PageTitle>Monitor de Salida Outbox · @(Tenant.GroupName)</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
    <!-- Encabezado de la página -->
    <div class="d-flex flex-wrap justify-space-between align-center gap-4 mb-6">
        <div>
            <div class="d-flex align-center gap-2 mb-1">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                    @(Tenant.GroupName)
                </MudChip>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Despacho y Notificaciones (ADR07 / PA11 / RF65)</MudText>
            </div>
            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0F172A; letter-spacing: -0.02em;">
                Monitor de Cola Outbox
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                Supervisión transaccional de correos enviados, reintentos con backoff exponencial e idempotencia garantizada.
            </MudText>
        </div>

        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Default" 
                       StartIcon="@Icons.Material.Filled.Refresh" 
                       OnClick="CargarDatosAsync">
                Actualizar
            </MudButton>

            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Send" 
                       Disabled="_procesando"
                       OnClick="DespacharLoteAsync">
                Despachar Cola Ahora
            </MudButton>
        </div>
    </div>

    <!-- Tarjetas de Métricas de Salud -->
    <MudGrid Spacing="3" Class="mb-6">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true" Class="rounded-xl border bg-white p-4">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Total Registrados</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0F172A;">
                            @(_resumen?.TotalMensajes ?? 0)
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.AllInbox" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true" Class="rounded-xl border bg-white p-4">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Pendientes en Cola</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #F59E0B;">
                            @(_resumen?.Pendientes ?? 0)
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.HourglassTop" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true" Class="rounded-xl border bg-white p-4">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Enviados con Éxito</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #10B981;">
                            @(_resumen?.Enviados ?? 0)
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Success" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard Elevation="0" Outlined="true" Class="rounded-xl border bg-white p-4">
                <div class="d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">Reintentos / Fallidos</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: #EF4444;">
                            @((_resumen?.EnReintento ?? 0) + (_resumen?.Fallidos ?? 0))
                        </MudText>
                    </div>
                    <MudAvatar Color="Color.Error" Variant="Variant.Outlined">
                        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" />
                    </MudAvatar>
                </div>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- Tabla Principal de Mensajes Outbox -->
    <MudCard Elevation="0" Outlined="true" Class="rounded-xl border bg-white">
        <MudCardContent>
            <!-- Filtros -->
            <div class="d-flex flex-wrap gap-4 align-center mb-4">
                <MudTextField T="string" 
                              Label="Buscar por asunto, destinatario o evento" 
                              @bind-Value="_busqueda" 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense" 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Immediate="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="CargarDatosAsync"
                              Style="min-width: 300px;" />

                <MudSelect T="EstadoMensajeOutbox?" 
                           Label="Filtrar por Estado" 
                           Value="_filtroEstado" 
                           ValueChanged="OnFiltroEstadoChanged"
                           Variant="Variant.Outlined" 
                           Dense="true" 
                           Clearable="true" 
                           Style="min-width: 200px;">
                    <MudSelectItem T="EstadoMensajeOutbox?" Value="@((EstadoMensajeOutbox?)null)">Todos los estados</MudSelectItem>
                    <MudSelectItem T="EstadoMensajeOutbox?" Value="@EstadoMensajeOutbox.Pendiente">Pendiente</MudSelectItem>
                    <MudSelectItem T="EstadoMensajeOutbox?" Value="@EstadoMensajeOutbox.Enviado">Enviado</MudSelectItem>
                    <MudSelectItem T="EstadoMensajeOutbox?" Value="@EstadoMensajeOutbox.EnProceso">En Proceso</MudSelectItem>
                    <MudSelectItem T="EstadoMensajeOutbox?" Value="@EstadoMensajeOutbox.Fallido">Fallido</MudSelectItem>
                </MudSelect>
            </div>

            @if (_cargando)
            {
                <div class="d-flex justify-center py-8">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                </div>
            }
            else if (_mensajes.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text" Class="my-4">
                    No se encontraron mensajes en la cola Outbox con los filtros indicados.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_mensajes" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Fecha Creación</MudTh>
                        <MudTh>Destinatario</MudTh>
                        <MudTh>Asunto</MudTh>
                        <MudTh>Tipo Evento</MudTh>
                        <MudTh>Intentos</MudTh>
                        <MudTh>Estado</MudTh>
                        <MudTh>Detalle / Error</MudTh>
                        <MudTh Style="text-align: right;">Acciones</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Fecha">
                            @context.FechaCreacionUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
                        </MudTd>
                        <MudTd DataLabel="Destinatario">
                            <MudText Typo="Typo.body2" Style="font-weight: 700;">@context.DestinatarioNombre</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.DestinatarioEmail</MudText>
                        </MudTd>
                        <MudTd DataLabel="Asunto">
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">@context.Asunto</MudText>
                        </MudTd>
                        <MudTd DataLabel="Tipo Evento">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                @context.TipoEvento
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Intentos">
                            <MudText Typo="Typo.body2">@context.Reintentos / @context.MaxReintentos</MudText>
                        </MudTd>
                        <MudTd DataLabel="Estado">
                            <MudChip T="string" Size="Size.Small" Color="@ObtenerColorEstado(context.Estado)" Variant="Variant.Filled">
                                @context.Estado.ToString()
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Detalle">
                            @if (!string.IsNullOrWhiteSpace(context.ErrorUltimoReintento))
                            {
                                <MudTooltip Text="@context.ErrorUltimoReintento">
                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="d-block text-truncate" Style="max-width: 250px;">
                                        @context.ErrorUltimoReintento
                                    </MudText>
                                </MudTooltip>
                            }
                            else if (context.FechaProcesadoUtc.HasValue)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Success">
                                    Entregado @context.FechaProcesadoUtc.Value.ToLocalTime().ToString("HH:mm:ss")
                                </MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">En espera de despacho</MudText>
                            }
                        </MudTd>
                        <MudTd DataLabel="Acciones" Style="text-align: right;">
                            @if (context.Estado != EstadoMensajeOutbox.Enviado)
                            {
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Warning" 
                                           Size="Size.Small" 
                                           StartIcon="@Icons.Material.Filled.Replay"
                                           OnClick="@(() => ReintentarMensajeAsync(context.Id))">
                                    Reintentar
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private bool _cargando = true;
    private bool _procesando = false;
    private ResumenOutboxDto? _resumen;
    private IReadOnlyList<MensajeOutbox> _mensajes = [];

    private string? _busqueda;
    private EstadoMensajeOutbox? _filtroEstado;

    protected override async Task OnInitializedAsync()
    {
        await CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        _cargando = true;
        try
        {
            _resumen = await ServicioOutbox.ObtenerResumenEstadisticasAsync();
            _mensajes = await ServicioOutbox.ObtenerMensajesAsync(_filtroEstado, _busqueda);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnFiltroEstadoChanged(EstadoMensajeOutbox? estado)
    {
        _filtroEstado = estado;
        await CargarDatosAsync();
    }

    private async Task DespacharLoteAsync()
    {
        _procesando = true;
        try
        {
            var despachados = await ServicioOutbox.ProcesarLotePendienteAsync();
            Snackbar.Add($"Lote procesado: {despachados} mensajes enviados con éxito.", Severity.Success);
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _procesando = false;
        }
    }

    private async Task ReintentarMensajeAsync(Guid mensajeId)
    {
        try
        {
            await ServicioOutbox.ReintentarMensajeAsync(mensajeId);
            Snackbar.Add("Mensaje restablecido en cola para despacho inmediato.", Severity.Info);
            await CargarDatosAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private Color ObtenerColorEstado(EstadoMensajeOutbox estado) => estado switch
    {
        EstadoMensajeOutbox.Enviado => Color.Success,
        EstadoMensajeOutbox.Pendiente => Color.Warning,
        EstadoMensajeOutbox.EnProceso => Color.Info,
        EstadoMensajeOutbox.Fallido => Color.Error,
        _ => Color.Default
    };
}
