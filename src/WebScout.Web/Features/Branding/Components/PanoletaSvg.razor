@using WebScout.Web.Common.Domain

@if (EffectiveConfig != null)
{
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 100 80"
         width="@Width"
         height="@Height"
         class="scout-panoleta-svg @(Class ?? CssClass)"
         role="img"
         aria-label="@(Title ?? "Pañoleta Scout Oficial")"
         @attributes="AdditionalAttributes">
        <title>@(Title ?? "Pañoleta Scout Oficial")</title>
        
        <defs>
            <filter id="@FilterId" x="-10%" y="-10%" width="120%" height="130%" filterUnits="userSpaceOnUse">
                <feDropShadow dx="0" dy="1.5" stdDeviation="1.5" flood-opacity="0.16" />
            </filter>
        </defs>

        <g filter="url(#@FilterId)">
            <!-- Triángulo Exterior: Ribete exterior perimetral -->
            <polygon points="4,3 96,3 50,74" 
                     fill="@EffectiveConfig.BorderColorHex" 
                     stroke="@EffectiveConfig.BorderColorHex" 
                     stroke-width="1.5" 
                     stroke-linejoin="round" />

            <!-- Triángulo Interior: Color base del pañuelo -->
            <polygon points="11,7 89,7 50,66" 
                     fill="@EffectiveConfig.BaseColorHex" />

            @if (!string.IsNullOrEmpty(EffectiveConfig.CentralStripeColorHex))
            {
                <!-- Cinta Central Divisoria -->
                <line x1="50" y1="7" x2="50" y2="66" 
                      stroke="@EffectiveConfig.CentralStripeColorHex" 
                      stroke-width="4.5" 
                      stroke-linecap="square" />
            }

            @if (EffectiveConfig.HasEmblem)
            {
                <!-- Emblema Heráldico Central en el Vértice -->
                <circle cx="50" cy="40" r="8.5" fill="#FFFFFF" stroke="@EffectiveConfig.BorderColorHex" stroke-width="1.2" />
                
                <!-- Silueta Vectorial Oficial de la Flor de Lis -->
                <g transform="translate(50, 40) scale(0.24)">
                    <path d="M 0 -17 C -2 -10, -5 -4, -7 2 C -3 3, -1 6, 0 12 C 1 6, 3 3, 7 2 C 5 -4, 2 -10, 0 -17 Z" fill="@EffectiveConfig.BorderColorHex" />
                    <path d="M -2 2 C -8 3, -14 7, -13 12 C -11 15, -6 13, -2 8 Z" fill="@EffectiveConfig.BorderColorHex" />
                    <path d="M 2 2 C 8 3, 14 7, 13 12 C 11 15, 6 13, 2 8 Z" fill="@EffectiveConfig.BorderColorHex" />
                    <rect x="-8" y="5" width="16" height="2.5" rx="1" fill="@EffectiveConfig.BorderColorHex" />
                    <path d="M -3 9 C -5 14, -3 17, 0 18 C 3 17, 5 14, 3 9 Z" fill="@EffectiveConfig.BorderColorHex" />
                </g>
            }
        </g>
    </svg>
}

@code {
    [Parameter] public PanoletaConfig? Config { get; set; }
    [Parameter] public int Width { get; set; } = 80;
    [Parameter] public int Height { get; set; } = 64;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter(CaptureUnmatchedValues = true)] public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string FilterId = "shadow-" + Guid.NewGuid().ToString("N")[..8];
    private PanoletaConfig EffectiveConfig => Config ?? PanoletaConfig.Lestonnac330;
}
