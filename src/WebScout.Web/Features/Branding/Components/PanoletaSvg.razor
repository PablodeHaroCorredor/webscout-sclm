@using WebScout.Web.Common.Domain

@if (EffectiveConfig != null)
{
    <svg xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 100 80"
         width="@Width"
         height="@Height"
         class="scout-panoleta-svg @CssClass"
         role="img"
         aria-label="@(Title ?? "Pañoleta Scout Oficial")">
        <title>@(Title ?? "Pañoleta Scout Oficial")</title>
        
        <defs>
            <filter id="@FilterId" x="-10%" y="-10%" width="120%" height="130%" filterUnits="userSpaceOnUse">
                <feDropShadow dx="0" dy="2" stdDeviation="2" flood-opacity="0.18" />
            </filter>
        </defs>

        <g filter="url(#@FilterId)">
            <!-- Triángulo Exterior: Ribete exterior perimetral -->
            <polygon points="4,3 96,3 50,74" 
                     fill="@EffectiveConfig.BorderColorHex" 
                     stroke="@EffectiveConfig.BorderColorHex" 
                     stroke-width="2" 
                     stroke-linejoin="round" />

            <!-- Triángulo Interior: Color base del pañuelo -->
            <polygon points="12,7 88,7 50,65" 
                     fill="@EffectiveConfig.BaseColorHex" />

            @if (!string.IsNullOrEmpty(EffectiveConfig.CentralStripeColorHex))
            {
                <!-- Cinta Central Divisoria -->
                <line x1="50" y1="7" x2="50" y2="65" 
                      stroke="@EffectiveConfig.CentralStripeColorHex" 
                      stroke-width="5" 
                      stroke-linecap="square" />
            }

            @if (EffectiveConfig.HasEmblem)
            {
                <!-- Emblema / Insignia central en el pico -->
                <circle cx="50" cy="38" r="9" fill="#FFFFFF" stroke="@EffectiveConfig.BorderColorHex" stroke-width="1.5" />
                @((MarkupString)"<text x='50' y='41' font-size='10' text-anchor='middle' dominant-baseline='central'>⚜️</text>")
            }
        </g>
    </svg>
}

@code {
    [Parameter] public PanoletaConfig? Config { get; set; }
    [Parameter] public int Width { get; set; } = 80;
    [Parameter] public int Height { get; set; } = 64;
    [Parameter] public string? CssClass { get; set; }
    [Parameter] public string? Title { get; set; }

    private string FilterId = "shadow-" + Guid.NewGuid().ToString("N")[..8];
    private PanoletaConfig EffectiveConfig => Config ?? PanoletaConfig.Lestonnac330;
}