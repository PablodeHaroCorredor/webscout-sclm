@using MudBlazor
@using WebScout.Web.Common.Domain
@using WebScout.Web.Features.Admissions.Domain
@using WebScout.Web.Features.Identity.Domain

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PersonAddAlt1" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Style="font-weight: 700;">
                Incorporar Educando al Censo Oficial
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Esta acción incorporará a <strong>@Solicitud.NombreCompletoEducando</strong> al censo de educandos activos,
            vinculará a su tutor legal (creando la cuenta familiar si no existía) y encolará la notificación de bienvenida con acceso al Portal de Familias (RF01 / RF12).
        </MudText>

        <MudGrid Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField Label="Nombre del Educando" Value="@Solicitud.NombreEducando" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Apellidos del Educando" Value="@Solicitud.ApellidosEducando" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Fecha de Nacimiento" Value="@Solicitud.FechaNacimiento.ToString("dd/MM/yyyy")" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect T="RamaScout" Label="Rama Asignada" @bind-Value="_ramaSeleccionada" Variant="Variant.Outlined" Dense="true">
                    <MudSelectItem T="RamaScout" Value="@RamaScout.Castores">Castores (6-8 años)</MudSelectItem>
                    <MudSelectItem T="RamaScout" Value="@RamaScout.Manada">Manada (8-11 años)</MudSelectItem>
                    <MudSelectItem T="RamaScout" Value="@RamaScout.Tropa">Tropa Scout (11-14 años)</MudSelectItem>
                    <MudSelectItem T="RamaScout" Value="@RamaScout.Escultas">Unidad Esculta (14-17 años)</MudSelectItem>
                    <MudSelectItem T="RamaScout" Value="@RamaScout.Clan">Clan Rover (17-21 años)</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;" Class="mb-1">
                    Datos del Tutor Legal (Cuenta Familiar)
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField Label="Tutor Legal" Value="@Solicitud.NombreTutor" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Correo de Acceso" Value="@Solicitud.EmailTutor" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Teléfono de Contacto" Value="@Solicitud.TelefonoTutor" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Label="Relación / Parentesco" Value="@Solicitud.RelacionTutor" ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField T="string" 
                              Label="Notas Internas de Secretaría (opcional)" 
                              @bind-Value="_notasKraal" 
                              Lines="2" 
                              Variant="Variant.Outlined" 
                              Placeholder="Observaciones para el censo..." />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Confirmar" StartIcon="@Icons.Material.Filled.CheckCircle">
            Confirmar Alta en Censo
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public SolicitudAdmision Solicitud { get; set; } = null!;

    private RamaScout _ramaSeleccionada;
    private string? _notasKraal;

    protected override void OnInitialized()
    {
        _ramaSeleccionada = Solicitud.RamaSugerida != RamaScout.Ninguna 
            ? Solicitud.RamaSugerida 
            : SolicitudAdmision.CalcularRamaPedagogica(Solicitud.FechaNacimiento);

        _notasKraal = Solicitud.NotasKraal;
    }

    private void Cancelar() => MudDialog.Cancel();

    private void Confirmar()
    {
        MudDialog.Close(DialogResult.Ok(new ResultadoIncorporacionDto(_ramaSeleccionada, _notasKraal)));
    }

    public record ResultadoIncorporacionDto(RamaScout RamaAsignada, string? NotasKraal);
}
