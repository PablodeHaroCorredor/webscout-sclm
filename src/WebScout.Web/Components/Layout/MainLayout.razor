@inherits LayoutComponentBase
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<MudThemeProvider Theme="@CurrentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <!-- Barra Superior Limpia y Agnóstica -->
    <MudAppBar Elevation="0" Style="border-bottom: 1px solid #E2E8F0; background-color: #FFFFFF; color: #0F172A; height: 64px;" Fixed="true" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        
        <div class="d-flex align-center gap-2 ms-2">
            <MudText Typo="Typo.h6" Style="font-weight: 700; font-size: 1.15rem; color: #0F172A;">
                WebScout SCLM
            </MudText>
            @if (Tenant.IsResolved)
            {
                <span style="color: #CBD5E1;">|</span>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @Tenant.GroupName
                </MudText>
            }
        </div>

        <MudSpacer />

        <!-- Estado de Autenticación Discreto -->
        <AuthorizeView>
            <Authorized>
                <div class="d-flex align-center gap-3">
                    <div class="d-none d-sm-block text-end">
                        <MudText Typo="Typo.body2" Style="font-weight: 600; line-height: 1.2; color: #0F172A;">
                            @context.User.Identity?.Name
                        </MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(Tenant.IsResolved ? Tenant.GroupName : "SCLM")
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" 
                               Color="Color.Default" 
                               Size="Size.Small"
                               Href="/auth/logout"
                               StartIcon="@Icons.Material.Filled.Logout">
                        Salir
                    </MudButton>
                </div>
            </Authorized>
            <NotAuthorized>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Small"
                           Href="/login"
                           StartIcon="@Icons.Material.Filled.Login">
                    Iniciar Sesión
                </MudButton>
            </NotAuthorized>
        </AuthorizeView>
    </MudAppBar>

    <!-- Menú Lateral Simplificado: SOLO lo desarrollado -->
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader Class="d-flex align-center gap-3 py-3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Explore" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">WebScout SCLM</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@(Tenant.IsResolved ? Tenant.GroupName : "Castilla-La Mancha")</MudText>
            </div>
        </MudDrawerHeader>
        
        <MudDivider />

        <MudNavMenu Bordered="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Inicio
            </MudNavLink>
            <MudNavLink Href="/contacto" Icon="@Icons.Material.Filled.ContactMail">
                Contacto y Admisiones
            </MudNavLink>

            <AuthorizeView Roles="Familia">
                <Authorized>
                    <MudNavGroup Title="Portal Familias" Icon="@Icons.Material.Filled.FamilyRestroom" Expanded="true">
                        <MudNavLink Href="/familias" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
                            Mi Espacio Familiar
                        </MudNavLink>
                        <MudNavLink Href="/familias/educandos" Icon="@Icons.Material.Filled.ChildCare">
                            Educandos y Fichas Médicas
                        </MudNavLink>
                        <MudNavLink Href="/familias/actividades" Icon="@Icons.Material.Filled.EventAvailable">
                            Actividades y Salidas
                        </MudNavLink>
                        <MudNavLink Href="/familias/inscripciones" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                            Mis Inscripciones y Pagos
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="Scouter,Coordinacion,Administracion">
                <Authorized>
                    <MudNavGroup Title="Gestión Kraal" Icon="@Icons.Material.Filled.Diversity3" Expanded="true">
                        <MudNavLink Href="/kraal/inscripciones" Icon="@Icons.Material.Filled.FactCheck">
                            Mesa de Inscripciones
                        </MudNavLink>
                        <MudNavLink Href="/kraal/educandos" Icon="@Icons.Material.Filled.Groups">
                            Censo de Educandos
                        </MudNavLink>
                        <MudNavLink Href="/kraal/actividades" Icon="@Icons.Material.Filled.Hiking">
                            Gestor de Actividades
                        </MudNavLink>
                        <MudNavLink Href="/kraal/admisiones" Icon="@Icons.Material.Filled.Inbox">
                            Buzón y Admisiones
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>

            <AuthorizeView Roles="SuperAdmin">
                <Authorized>
                    <MudNavGroup Title="Federación SCLM" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="true">
                        <MudNavLink Href="/admin/grupos" Icon="@Icons.Material.Filled.Hub">
                            Grupos y Tenants
                        </MudNavLink>
                    </MudNavGroup>
                </Authorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <!-- Contenido Principal con espacio superior garantizado para que el AppBar no tape nada -->
    <MudMainContent Class="px-4 px-md-8 pb-8" Style="background-color: #F8FAFC; min-height: 100vh; padding-top: calc(var(--mud-appbar-height, 64px) + 28px) !important;">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;
    private MudTheme CurrentTheme => ScoutMudTheme.CreateTheme(Tenant.Palette);

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
