@inherits LayoutComponentBase
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<MudThemeProvider Theme="@CurrentTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" Dense="false">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        
        <div class="d-flex align-center gap-3 ms-2">
            <PanoletaSvg Config="ActivePanoleta" Width="40" Height="32" />
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">
                    @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")
                </MudText>
                <MudText Typo="Typo.caption" Style="opacity: 0.85; font-size: 0.725rem;">
                    Scouts de Castilla-La Mancha · Grupo Nº @(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "-")
                </MudText>
            </div>
        </div>

        <MudSpacer />

        <div class="d-none d-md-flex align-center gap-2 me-4">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Surface" Style="color: var(--mud-palette-text-primary);">
                @(Tenant.IsResolved ? Tenant.TenantSlug : "sin-tenant")
            </MudChip>
            <MudButton Variant="Variant.Outlined" 
                       Size="Size.Small" 
                       Color="Color.Inherit"
                       Href="?tenant=lestonnac"
                       Style="border-color: rgba(255,255,255,0.4);">
                Lestonnac 330
            </MudButton>
            <MudButton Variant="Variant.Outlined" 
                       Size="Size.Small" 
                       Color="Color.Inherit"
                       Href="?tenant=sanvicente"
                       Style="border-color: rgba(255,255,255,0.4);">
                San Vicente 412
            </MudButton>
        </div>

        <MudButton Variant="Variant.Filled" 
                   Color="Color.Secondary" 
                   Size="Size.Small"
                   Href="/diseno"
                   StartIcon="@Icons.Material.Filled.Palette">
            UI Kit
        </MudButton>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
        <MudDrawerHeader Class="d-flex align-center gap-2 py-3">
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Forest" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Mi Espacio Scout</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Portal del Educando y Familias</MudText>
            </div>
        </MudDrawerHeader>
        
        <MudDivider />

        <MudNavMenu Bordered="true">
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                Inicio y Portada
            </MudNavLink>
            <MudNavLink Href="/diseno" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AutoAwesome">
                Sistema de Diseño (MudBlazor)
            </MudNavLink>
            
            <MudNavGroup Title="Área Familiar" Icon="@Icons.Material.Filled.FamilyRestroom" Expanded="true">
                <MudNavLink Href="/tramites" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                    Mis Gestiones y Fichas
                </MudNavLink>
                <MudNavLink Href="/pedidos" Icon="@Icons.Material.Filled.ShoppingBag">
                    Uniformidad y Material
                </MudNavLink>
                <MudNavLink Href="/fotos" Icon="@Icons.Material.Filled.PhotoLibrary">
                    Galería Privada
                </MudNavLink>
            </MudNavGroup>

            <MudNavGroup Title="Gestión de Kraal" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                <MudNavLink Href="/revision" Icon="@Icons.Material.Filled.Rule">
                    Mesa de Revisión
                </MudNavLink>
                <MudNavLink Href="/secciones" Icon="@Icons.Material.Filled.Diversity3">
                    Ramas y Secciones
                </MudNavLink>
            </MudNavGroup>
        </MudNavMenu>

        <div class="mt-auto pa-4">
            <MudCard Elevation="0" Outlined="true" Class="pa-3" Style="background: #F8FAFC;">
                <MudText Typo="Typo.caption" Class="mud-text-secondary" Style="font-weight: 600;">
                    SCLM Platform v1.0
                </MudText>
                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary" Style="font-size: 0.7rem;">
                    Conformidad WCAG 2.2 AA · .NET 10
                </MudText>
            </MudCard>
        </div>
    </MudDrawer>

    <MudMainContent Class="pa-4 pa-md-6" Style="background-color: #F8FAFC; min-height: 100vh;">
        @Body
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool _drawerOpen = true;

    private PanoletaConfig ActivePanoleta => Tenant.TenantSlug switch
    {
        "sanvicente" => PanoletaConfig.SanVicente412,
        _ => PanoletaConfig.Lestonnac330
    };

    private MudTheme CurrentTheme => ScoutMudTheme.CreateTheme(ActivePanoleta);

    private void ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
    }
}
