@page "/diseno"
@page "/styleguide"
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<PageTitle>Guía de Estilo y Sistema de Diseño · @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")</PageTitle>

<div class="scout-container" style="padding-top: 2rem; padding-bottom: 4rem;">
    <!-- ====================================================================
         1. Barra de Navegación y Selector de Tenant
         ==================================================================== -->
    <header class="scout-card" style="margin-bottom: 2rem; border-top: 6px solid var(--scout-primary);">
        <div class="scout-card-body">
            <div class="scout-flex-between">
                <div>
                    <div class="scout-flex-gap" style="margin-bottom: 0.5rem;">
                        <span class="scout-badge scout-badge-info">⚜️ SCLM Design System v0.1</span>
                        <span class="scout-badge scout-badge-neutral">WCAG 2.2 AA Compliance</span>
                    </div>
                    <h1 class="scout-title-xl" style="margin-bottom: 0.25rem;">
                        Manual y Muestrario de Diseño Visual
                    </h1>
                    <p class="scout-text-muted" style="margin: 0;">
                        Visualización interactiva de tokens, componentes accesibles y personalización multitenant para <strong>@(Tenant.IsResolved ? Tenant.GroupName : "SCLM")</strong>.
                    </p>
                </div>

                <!-- Pañoleta Oficial del Tenant Activo -->
                <div style="text-align: center; background: #F8FAFC; padding: 1rem 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--scout-border-subtle);">
                    <PanoletaSvg Config="ActivePanoleta" Width="90" Height="70" Title="Pañoleta del Tenant" />
                    <div style="font-size: 0.8rem; font-weight: 700; color: var(--scout-text-main); margin-top: 0.25rem;">
                        @(Tenant.IsResolved ? Tenant.GroupName : "Lestonnac 330")
                    </div>
                    <div style="font-size: 0.75rem; color: var(--scout-text-muted);">
                        Grupo Nº @(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "330")
                    </div>
                </div>
            </div>

            <hr style="border: 0; border-top: 1px solid var(--scout-border-subtle); margin: 1.5rem 0;" />

            <!-- Selector dinámico de Tenant para comprobar adaptabilidad cromática -->
            <div class="scout-flex-between">
                <div class="scout-flex-gap">
                    <span style="font-weight: 600; font-size: 0.9rem;">🔄 Simular Grupo Scout:</span>
                    <a href="diseno?tenant=lestonnac" class="scout-btn scout-btn-sm @(Tenant.TenantSlug != "sanvicente" ? "scout-btn-primary" : "scout-btn-secondary")">
                        <span>⚜️</span> Lestonnac 330 (Verde/Amarillo)
                    </a>
                    <a href="diseno?tenant=sanvicente" class="scout-btn scout-btn-sm @(Tenant.TenantSlug == "sanvicente" ? "scout-btn-primary" : "scout-btn-secondary")">
                        <span>⚜️</span> San Vicente 412 (Azul/Rojo)
                    </a>
                </div>
                <div>
                    <a href="/" class="scout-btn scout-btn-sm scout-btn-secondary">
                        ← Volver a Portada
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ====================================================================
         2. Diagnóstico de Accesibilidad y Tokens del Tenant Activo
         ==================================================================== -->
    <section style="margin-bottom: 2.5rem;">
        <h2 class="scout-title-lg">1. Identidad Cromática del Grupo y Motor WCAG 2.2 AA</h2>
        <p class="scout-text-body">
            Cada grupo federado en SCLM proyecta sus propios colores de pañoleta y marca. El motor algorítmico calcula el ratio de luminancia en servidor para garantizar que ningún texto o control sea ilegible.
        </p>

        <div class="scout-grid-3">
            <!-- Tarjeta Color Principal -->
            <div class="scout-card" style="border-top: 5px solid @ActivePanoleta.BaseColorHex;">
                <div class="scout-card-body">
                    <div style="font-weight: 700; margin-bottom: 0.25rem;">Color Principal (Base)</div>
                    <div class="scout-code">@ActivePanoleta.BaseColorHex</div>
                    <div style="margin-top: 1rem; display: flex; align-items: center; justify-content: space-between;">
                        <span style="display: inline-block; width: 44px; height: 44px; border-radius: var(--radius-md); background: @ActivePanoleta.BaseColorHex; border: 1px solid rgba(0,0,0,0.1);"></span>
                        <div style="text-align: right;">
                            <div style="font-size: 0.8rem; color: var(--scout-text-muted);">Texto Automático:</div>
                            <strong style="color: @HeaderTextColor; background: @ActivePanoleta.BaseColorHex; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.85rem;">
                                @HeaderTextColor
                            </strong>
                        </div>
                    </div>
                </div>
                <div class="scout-card-footer">
                    <span style="font-size: 0.85rem;">Ratio Contraste: <strong>@ContrastRatio.ToString("F2"):1</strong></span>
                    <span class="scout-badge @(ContrastRatio >= 4.5 ? "scout-badge-success" : "scout-badge-danger")">
                        @(ContrastRatio >= 4.5 ? "✓ WCAG AA" : "✕ Falla AA")
                    </span>
                </div>
            </div>

            <!-- Tarjeta Color Ribete / Acento -->
            <div class="scout-card" style="border-top: 5px solid @ActivePanoleta.BorderColorHex;">
                <div class="scout-card-body">
                    <div style="font-weight: 700; margin-bottom: 0.25rem;">Ribete Oficial (Borde)</div>
                    <div class="scout-code">@ActivePanoleta.BorderColorHex</div>
                    <div style="margin-top: 1rem; display: flex; align-items: center; justify-content: space-between;">
                        <span style="display: inline-block; width: 44px; height: 44px; border-radius: var(--radius-md); background: @ActivePanoleta.BorderColorHex; border: 1px solid rgba(0,0,0,0.1);"></span>
                        <div style="text-align: right;">
                            <div style="font-size: 0.8rem; color: var(--scout-text-muted);">Texto Automático:</div>
                            <strong style="color: @BorderTextColor; background: @ActivePanoleta.BorderColorHex; padding: 0.2rem 0.5rem; border-radius: var(--radius-sm); font-size: 0.85rem;">
                                @BorderTextColor
                            </strong>
                        </div>
                    </div>
                </div>
                <div class="scout-card-footer">
                    <span style="font-size: 0.85rem;">Ratio Contraste: <strong>@BorderContrastRatio.ToString("F2"):1</strong></span>
                    <span class="scout-badge @(BorderContrastRatio >= 4.5 ? "scout-badge-success" : "scout-badge-danger")">
                        @(BorderContrastRatio >= 4.5 ? "✓ WCAG AA" : "✕ Falla AA")
                    </span>
                </div>
            </div>

            <!-- Tarjeta Pañoleta y Cinta Central -->
            <div class="scout-card" style="border-top: 5px solid #4A148C;">
                <div class="scout-card-body">
                    <div style="font-weight: 700; margin-bottom: 0.25rem;">Cinta Central y Heráldica</div>
                    <div class="scout-code">@(ActivePanoleta.CentralStripeColorHex ?? "Sin cinta central")</div>
                    <div style="margin-top: 1rem; display: flex; align-items: center; gap: 1rem;">
                        <PanoletaSvg Config="ActivePanoleta" Width="60" Height="48" />
                        <div style="font-size: 0.85rem; color: var(--scout-text-muted);">
                            Emblema: <strong>@(ActivePanoleta.HasEmblem ? "Flor de lis ⚜️" : "No aplica")</strong>
                        </div>
                    </div>
                </div>
                <div class="scout-card-footer">
                    <span style="font-size: 0.85rem; color: var(--scout-text-muted);">Componente:</span>
                    <span class="scout-badge scout-badge-info">SVG Paramétrico</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================================================================
         3. Código Cromático de Secciones Educativas
         ==================================================================== -->
    <section style="margin-bottom: 2.5rem;">
        <h2 class="scout-title-lg">2. Ramas Pedagógicas (Código Cromático SCLM)</h2>
        <p class="scout-text-body">
            Transversal a todos los grupos federados, cada rama scout dispone de su identidad visual y de edad para facilitar el reconocimiento instantáneo por parte de familias y educandos.
        </p>

        <div class="scout-grid-3">
            <div class="scout-card">
                <div class="scout-card-body">
                    <span class="scout-branch-badge scout-branch-castores">🐿️ Colonia de Castores</span>
                    <p style="font-size: 0.9rem; margin: 0.75rem 0 0.25rem 0; font-weight: 600;">6 a 8 años</p>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">Lema: <em>Compartir</em>. Naranja y turquesa del río.</p>
                </div>
            </div>

            <div class="scout-card">
                <div class="scout-card-body">
                    <span class="scout-branch-badge scout-branch-manada">🐺 Manada de Lobatos</span>
                    <p style="font-size: 0.9rem; margin: 0.75rem 0 0.25rem 0; font-weight: 600;">8 a 11 años</p>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">Lema: <em>Haremos lo mejor</em>. Amarillo y marrón selva.</p>
                </div>
            </div>

            <div class="scout-card">
                <div class="scout-card-body">
                    <span class="scout-branch-badge scout-branch-tropa">⛺ Sección Scout / Tropa</span>
                    <p style="font-size: 0.9rem; margin: 0.75rem 0 0.25rem 0; font-weight: 600;">11 a 14 años</p>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">Lema: <em>Siempre listos</em>. Azul cielo y verde bosque.</p>
                </div>
            </div>

            <div class="scout-card">
                <div class="scout-card-body">
                    <span class="scout-branch-badge scout-branch-escultas">🧭 Unidad Esculta / Pioneros</span>
                    <p style="font-size: 0.9rem; margin: 0.75rem 0 0.25rem 0; font-weight: 600;">14 a 17 años</p>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">Lema: <em>Unidad</em>. Rojo valentía y blanco.</p>
                </div>
            </div>

            <div class="scout-card">
                <div class="scout-card-body">
                    <span class="scout-branch-badge scout-branch-clan">🥾 Clan Rover / Rutas</span>
                    <p style="font-size: 0.9rem; margin: 0.75rem 0 0.25rem 0; font-weight: 600;">17 a 21 años</p>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">Lema: <em>Servir</em>. Verde esperanza y burdeos.</p>
                </div>
            </div>

            <div class="scout-card" style="background: #F1F5F9; border-style: dashed;">
                <div class="scout-card-body" style="display: flex; flex-direction: column; justify-content: center; height: 100%;">
                    <div style="font-weight: 700; color: #475569; margin-bottom: 0.25rem;">⚜️ Kraal de Scouters</div>
                    <p class="scout-text-muted" style="margin: 0; font-size: 0.85rem;">
                        Educadores y responsables de grupo. Acceso a paneles de revisión, firmas y expedientes.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================================================================
         4. Botones Táctiles Móviles y Estados Semánticos
         ==================================================================== -->
    <section style="margin-bottom: 2.5rem;">
        <h2 class="scout-title-lg">3. Botones Móviles Accesibles (Área $\ge 44 \times 44\text{px}$) e Insignias</h2>
        <p class="scout-text-body">
            Diseñados para pulsar con pulgar en pantallas pequeñas sin errores ni falsas pulsaciones involuntarias.
        </p>

        <div class="scout-card">
            <div class="scout-card-body">
                <div style="font-weight: 600; margin-bottom: 0.75rem;">Jerarquía de Botones de Acción:</div>
                <div class="scout-flex-gap" style="margin-bottom: 1.5rem;">
                    <button type="button" class="scout-btn scout-btn-primary">
                        <span>📝</span> Presentar Nueva Autorización
                    </button>
                    <button type="button" class="scout-btn scout-btn-secondary">
                        <span>📄</span> Descargar Modelo Vigente
                    </button>
                    <button type="button" class="scout-btn scout-btn-accent">
                        <span>🛒</span> Solicitar Uniformidad
                    </button>
                    <button type="button" class="scout-btn scout-btn-warning">
                        <span>✏️</span> Corregir Expediente
                    </button>
                    <button type="button" class="scout-btn scout-btn-danger">
                        <span>✕</span> Cancelar Trámite
                    </button>
                    <button type="button" class="scout-btn scout-btn-primary" disabled>
                        <span>🔒</span> Plazo Cerrado
                    </button>
                </div>

                <div style="font-weight: 600; margin-bottom: 0.75rem;">Insignias de Estado Semánticas (Con Icono para Daltonismo):</div>
                <div class="scout-flex-gap">
                    <span class="scout-badge scout-badge-success">✓ Confirmado por Tesorería</span>
                    <span class="scout-badge scout-badge-warning">⏳ Pendiente de Conciliación</span>
                    <span class="scout-badge scout-badge-danger">⚠️ Requiere Subsanación</span>
                    <span class="scout-badge scout-badge-info">ℹ️ En Revisión por Kraal</span>
                    <span class="scout-badge scout-badge-neutral">🔒 Archivado / Cerrado</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================================================================
         5. Patrón de UX: Tarjeta de Participante (Área Familiar)
         ==================================================================== -->
    <section style="margin-bottom: 2.5rem;">
        <h2 class="scout-title-lg">4. Patrón Familiar: Tarjeta de Educando y Trámites Vivos</h2>
        <p class="scout-text-body">
            La vista principal de las familias agrupa las actividades pendientes por hijo, evitando mezclar expedientes o confundir a los padres cuando tienen varios niños en distintas secciones.
        </p>

        <div class="scout-grid-2">
            <!-- Participante 1: Lucas (Manada) -->
            <div class="scout-card">
                <div class="scout-card-header">
                    <div>
                        <span class="scout-branch-badge scout-branch-manada" style="margin-bottom: 0.25rem;">🐺 Manada de Lobatos</span>
                        <div style="font-size: 1.15rem; font-weight: 700; color: var(--scout-text-main);">
                            Lucas Martín García
                        </div>
                    </div>
                    <span class="scout-badge scout-badge-warning">1 Trámite Pendiente</span>
                </div>
                <div class="scout-card-body">
                    <div style="background: #F8FAFC; border: 1px solid var(--scout-border-subtle); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem;">
                        <div class="scout-flex-between" style="margin-bottom: 0.5rem;">
                            <strong style="color: var(--scout-text-main); font-size: 0.95rem;">🏕️ Acampada de San Jorge 2027</strong>
                            <span class="scout-badge scout-badge-danger" style="font-size: 0.75rem;">Cierra en 3 días</span>
                        </div>
                        <p class="scout-text-muted" style="font-size: 0.85rem; margin-bottom: 0.75rem;">
                            Lugar: Albergue Juvenil Riópar · Coste: 45,00 €
                        </p>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem;">
                            <div>📄 Autorización firmada: <strong class="scout-badge scout-badge-success" style="font-size: 0.7rem;">✓ Versión 1 entregada</strong></div>
                            <div>💳 Justificante bancario: <strong class="scout-badge scout-badge-warning" style="font-size: 0.7rem;">⏳ Adjunto (en revisión)</strong></div>
                        </div>
                    </div>
                </div>
                <div class="scout-card-footer">
                    <button type="button" class="scout-btn scout-btn-sm scout-btn-secondary">
                        Ver Ficha Médica
                    </button>
                    <button type="button" class="scout-btn scout-btn-sm scout-btn-primary">
                        Detalles del Trámite
                    </button>
                </div>
            </div>

            <!-- Participante 2: Lucía (Sección Scout) -->
            <div class="scout-card">
                <div class="scout-card-header">
                    <div>
                        <span class="scout-branch-badge scout-branch-tropa" style="margin-bottom: 0.25rem;">⛺ Sección Scout</span>
                        <div style="font-size: 1.15rem; font-weight: 700; color: var(--scout-text-main);">
                            Lucía Martín García
                        </div>
                    </div>
                    <span class="scout-badge scout-badge-success">Todo al día</span>
                </div>
                <div class="scout-card-body">
                    <div style="background: #F8FAFC; border: 1px solid var(--scout-border-subtle); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1rem;">
                        <div class="scout-flex-between" style="margin-bottom: 0.5rem;">
                            <strong style="color: var(--scout-text-main); font-size: 0.95rem;">🌲 Campamento de Pascua</strong>
                            <span class="scout-badge scout-badge-success" style="font-size: 0.75rem;">Plaza Confirmada</span>
                        </div>
                        <p class="scout-text-muted" style="font-size: 0.85rem; margin-bottom: 0.75rem;">
                            Lugar: Sierra de Alcaraz · Coste: 60,00 €
                        </p>
                        <div style="display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem;">
                            <div>📄 Autorización: <strong class="scout-badge scout-badge-success" style="font-size: 0.7rem;">✓ Verificada por Scouter</strong></div>
                            <div>💳 Pago de actividad: <strong class="scout-badge scout-badge-success" style="font-size: 0.7rem;">✓ Conciliado</strong></div>
                        </div>
                    </div>
                </div>
                <div class="scout-card-footer">
                    <button type="button" class="scout-btn scout-btn-sm scout-btn-secondary">
                        Ver Ficha Médica
                    </button>
                    <button type="button" class="scout-btn scout-btn-sm scout-btn-secondary">
                        Descargar Justificante
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================================================================
         6. Formularios Accesibles y Alertas del Sistema
         ==================================================================== -->
    <section>
        <h2 class="scout-title-lg">5. Formularios Accesibles y Mensajes de Feedback</h2>
        <p class="scout-text-body">
            Entradas con etiquetas visibles persistentes, foco resaltado y mensajes de alerta constructivos.
        </p>

        <!-- Banners de Alerta -->
        <div class="scout-alert scout-alert-success">
            <span style="font-size: 1.25rem;">✓</span>
            <div>
                <strong>Inscripción tramitada correctamente:</strong> Hemos registrado tu autorización para la actividad. Recibirás confirmación cuando el Kraal revise la documentación.
            </div>
        </div>

        <div class="scout-alert scout-alert-warning">
            <span style="font-size: 1.25rem;">⚠️</span>
            <div>
                <strong>Plazo de inscripción próximo a expirar:</strong> Quedan menos de 72 horas para adjuntar el justificante bancario de la Acampada de San Jorge.
            </div>
        </div>

        <div class="scout-alert scout-alert-danger">
            <span style="font-size: 1.25rem;">✕</span>
            <div>
                <strong>Documento obsoleto detectado:</strong> El modelo de autorización médica fue actualizado el 10 de noviembre. Descarga la nueva versión para poder completar la entrega.
            </div>
        </div>

        <!-- Muestra de Formulario -->
        <div class="scout-card" style="margin-top: 1.5rem;">
            <div class="scout-card-body">
                <div class="scout-grid-2">
                    <div class="scout-form-group">
                        <label class="scout-label" for="txtNombre">Nombre del Participante (Educando):</label>
                        <input id="txtNombre" class="scout-input" type="text" value="Lucas Martín García" />
                        <span class="scout-helper-text">Tal como figura en la tarjeta sanitaria o DNI.</span>
                    </div>

                    <div class="scout-form-group">
                        <label class="scout-label" for="txtDni">DNI / NIE del Titular Responsable (con error simulado):</label>
                        <input id="txtDni" class="scout-input scout-input-error" type="text" value="12345678" aria-invalid="true" aria-describedby="dniError" />
                        <span id="dniError" class="scout-error-message">⚠️ La letra del DNI no coincide con el dígito de control.</span>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@code {
    private PanoletaConfig ActivePanoleta => Tenant.TenantSlug switch
    {
        "sanvicente" => PanoletaConfig.SanVicente412,
        _ => PanoletaConfig.Lestonnac330
    };

    private string HeaderTextColor => WcagContrastCalculator.GetAccessibleTextColor(ActivePanoleta.BaseColorHex);
    private double ContrastRatio => WcagContrastCalculator.CalculateContrastRatio(HeaderTextColor, ActivePanoleta.BaseColorHex);

    private string BorderTextColor => WcagContrastCalculator.GetAccessibleTextColor(ActivePanoleta.BorderColorHex);
    private double BorderContrastRatio => WcagContrastCalculator.CalculateContrastRatio(BorderTextColor, ActivePanoleta.BorderColorHex);
}