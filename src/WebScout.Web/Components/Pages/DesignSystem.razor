@page "/diseno"
@page "/styleguide"
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<PageTitle>Sistema de Diseño (MudBlazor) · @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    <!-- ====================================================================
         Cabecera Hero del Sistema de Diseño
         ==================================================================== -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-6 mb-6 rounded-lg" Style="border-top: 5px solid var(--mud-palette-primary); background: #FFFFFF;">
        <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-4">
            <div>
                <div class="d-flex align-center gap-2 mb-2">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                        MudBlazor 9 · Material Design 3
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.CheckCircle">
                        WCAG 2.2 Nivel AA
                    </MudChip>
                </div>
                <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -0.02em;">
                    Sistema de Diseño e Identidad Visual
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1" Style="max-width: 650px;">
                    Catálogo de componentes interactivos, tokens cromáticos y motor de accesibilidad adaptado para 
                    <strong>@(Tenant.IsResolved ? Tenant.GroupName : "Grupo Scout Lestonnac 330")</strong>.
                </MudText>
            </div>

            <!-- Previsualización de la Pañoleta Vectorial Oficial -->
            <MudPaper Elevation="0" Outlined="true" Class="pa-3 d-flex flex-column align-center" Style="background: #F8FAFC; min-width: 160px;">
                <PanoletaSvg Config="ActivePanoleta" Width="80" Height="64" />
                <MudText Typo="Typo.subtitle2" Class="mt-2" Style="font-weight: 700;">
                    @(Tenant.IsResolved ? Tenant.GroupName : "Lestonnac 330")
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Grupo Nº @(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "330") · SCLM
                </MudText>
            </MudPaper>
        </div>

        <MudDivider Class="my-4" />

        <!-- Selector en Caliente de Grupo Scout (Tenant) -->
        <div class="d-flex flex-wrap justify-space-between align-center gap-3">
            <div class="d-flex flex-wrap align-center gap-2">
                <MudText Typo="Typo.body2" Style="font-weight: 600;">Simular Identidad de Grupo:</MudText>
                <MudButton Variant="@(Tenant.TenantSlug != "sanvicente" ? Variant.Filled : Variant.Outlined)" 
                           Color="Color.Primary" 
                           Size="Size.Small"
                           Href="diseno?tenant=lestonnac"
                           StartIcon="@Icons.Material.Filled.Forest">
                    Lestonnac 330 (Verde / Amarillo)
                </MudButton>
                <MudButton Variant="@(Tenant.TenantSlug == "sanvicente" ? Variant.Filled : Variant.Outlined)" 
                           Color="Color.Primary" 
                           Size="Size.Small"
                           Href="diseno?tenant=sanvicente"
                           StartIcon="@Icons.Material.Filled.WaterDrop">
                    San Vicente 412 (Azul / Rojo)
                </MudButton>
            </div>
            
            <MudButton Variant="Variant.Text" 
                       Color="Color.Default" 
                       Size="Size.Small" 
                       Href="/" 
                       StartIcon="@Icons.Material.Filled.ArrowBack">
                Volver a Portada
            </MudButton>
        </div>
    </MudPaper>

    <!-- ====================================================================
         Pestañas Temáticas de Componentes MudBlazor
         ==================================================================== -->
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-6" Color="Color.Primary">
        
        <!-- PESTAÑA 1: PALETA Y ACCESIBILIDAD WCAG -->
        <MudTabPanel Text="Identidad y Contraste WCAG" Icon="@Icons.Material.Filled.Palette">
            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                1. Tokens Dinámicos del Tenant y Verificación WCAG 2.2 AA
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                El motor algorítmico calcula la luminancia relativa en el backend y asigna el texto contrastado automáticamente.
            </MudText>

            <MudGrid Class="mb-6">
                <!-- Color Base -->
                <MudItem xs="12" md="4">
                    <MudCard Outlined="true" Elevation="0">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Color Base de Pañoleta</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Color primario del portal</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="@($"background: {ActivePanoleta.BaseColorHex}; color: {HeaderTextColor};")">
                                    @ActivePanoleta.BaseColorHex
                                </MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex align-center justify-space-between mb-3">
                                <MudAvatar Rounded="true" Style="@($"background: {ActivePanoleta.BaseColorHex}; width: 52px; height: 52px; border: 1px solid rgba(0,0,0,0.1);")" />
                                <div class="text-end">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Texto Asignado:</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @HeaderTextColor
                                    </MudChip>
                                </div>
                            </div>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                Ratio de Contraste: @ContrastRatio.ToString("F2"):1
                            </MudText>
                            <MudProgressLinear Color="@(ContrastRatio >= 4.5 ? Color.Success : Color.Error)" 
                                               Value="@Math.Min(100, (int)(ContrastRatio / 21.0 * 100))" 
                                               Class="my-2" />
                            <MudChip T="string" Size="Size.Small" Color="@(ContrastRatio >= 4.5 ? Color.Success : Color.Error)" Variant="Variant.Filled" Icon="@(ContrastRatio >= 4.5 ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                                @(ContrastRatio >= 4.5 ? "Conforme WCAG AA" : "Incumple norma AA")
                            </MudChip>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Color Ribete -->
                <MudItem xs="12" md="4">
                    <MudCard Outlined="true" Elevation="0">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Ribete Perimetral</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Color secundario de acento</MudText>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Style="@($"background: {ActivePanoleta.BorderColorHex}; color: {BorderTextColor};")">
                                    @ActivePanoleta.BorderColorHex
                                </MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex align-center justify-space-between mb-3">
                                <MudAvatar Rounded="true" Style="@($"background: {ActivePanoleta.BorderColorHex}; width: 52px; height: 52px; border: 1px solid rgba(0,0,0,0.1);")" />
                                <div class="text-end">
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Texto Asignado:</MudText>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">
                                        @BorderTextColor
                                    </MudChip>
                                </div>
                            </div>
                            <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                Ratio de Contraste: @BorderContrastRatio.ToString("F2"):1
                            </MudText>
                            <MudProgressLinear Color="@(BorderContrastRatio >= 4.5 ? Color.Success : Color.Error)" 
                                               Value="@Math.Min(100, (int)(BorderContrastRatio / 21.0 * 100))" 
                                               Class="my-2" />
                            <MudChip T="string" Size="Size.Small" Color="@(BorderContrastRatio >= 4.5 ? Color.Success : Color.Error)" Variant="Variant.Filled" Icon="@(BorderContrastRatio >= 4.5 ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                                @(BorderContrastRatio >= 4.5 ? "Conforme WCAG AA" : "Incumple norma AA")
                            </MudChip>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Cinta Central y Heráldica -->
                <MudItem xs="12" md="4">
                    <MudCard Outlined="true" Elevation="0">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Heráldica y Cinta</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">Detalles vectoriales oficiales</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex align-center gap-4 mb-3">
                                <PanoletaSvg Config="ActivePanoleta" Width="60" Height="48" />
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">
                                        Cinta: @(ActivePanoleta.CentralStripeColorHex ?? "Sin cinta central")
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                        Flor de lis heráldica: @(ActivePanoleta.HasEmblem ? "Sí (vectorial)" : "No aplica")
                                    </MudText>
                                </div>
                            </div>
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                                Renderizado paramétrico puro en SVG sin dependencias de imágenes bitmap.
                            </MudAlert>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Código Cromático de Ramas -->
            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                2. Código Cromático Oficial de Ramas Pedagógicas
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Colores normalizados por franja de edad en toda la Federación SCLM.
            </MudText>

            <MudGrid>
                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #FFF7ED; border-color: #FDBA74;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #9A3412;">Castores</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #9A3412;">6 a 8 años</MudText>
                        <MudText Typo="Typo.caption" Style="color: #C2410C; font-style: italic;">Compartir</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #FEFCE8; border-color: #FDE047;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #854D0E;">Manada</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #854D0E;">8 a 11 años</MudText>
                        <MudText Typo="Typo.caption" Style="color: #A16207; font-style: italic;">Haremos lo mejor</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #F0F9FF; border-color: #7DD3FC;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #075985;">Sección Scout</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #075985;">11 a 14 años</MudText>
                        <MudText Typo="Typo.caption" Style="color: #0284C7; font-style: italic;">Siempre listos</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #FEF2F2; border-color: #FCA5A5;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #991B1B;">Escultas</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #991B1B;">14 a 17 años</MudText>
                        <MudText Typo="Typo.caption" Style="color: #DC2626; font-style: italic;">Unidad</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #F0FDF4; border-color: #86EFAC;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #166534;">Clan Rover</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #166534;">17 a 21 años</MudText>
                        <MudText Typo="Typo.caption" Style="color: #15803D; font-style: italic;">Servir</MudText>
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" sm="6" md="4" lg="2">
                    <MudPaper Outlined="true" Class="pa-3 text-center" Style="background: #F8FAFC; border-style: dashed;">
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: #334155;">Kraal Scouter</MudText>
                        <MudText Typo="Typo.caption" Class="d-block" Style="color: #475569;">Educadores</MudText>
                        <MudText Typo="Typo.caption" Style="color: #64748B;">Revisión y firma</MudText>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- PESTAÑA 2: COMPONENTES Y BOTONES -->
        <MudTabPanel Text="Botones y Alertas" Icon="@Icons.Material.Filled.SmartButton">
            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                Jerarquía de Botones Táctiles Móviles (Objetivo $\ge 44 \times 44\text{px}$)
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Componentes MudBlazor estilizados automáticamente con las elevaciones y micro-interacciones de Material Design.
            </MudText>

            <MudPaper Outlined="true" Class="pa-4 mb-6">
                <div class="d-flex flex-wrap align-center gap-3 mb-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Draw">
                        Firmar Autorización
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download">
                        Descargar Modelo PDF
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ShoppingBag">
                        Solicitar Uniformidad
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit">
                        Subsanar Expediente
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel">
                        Anular Solicitud
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="true" StartIcon="@Icons.Material.Filled.Lock">
                        Plazo Cerrado
                    </MudButton>
                </div>

                <MudDivider Class="my-3" />

                <MudText Typo="Typo.subtitle2" Class="mb-2" Style="font-weight: 700;">
                    Insignias de Estado Semánticas (Con Iconografía para Daltonismo):
                </MudText>
                <div class="d-flex flex-wrap gap-2">
                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                        Confirmado por Tesorería
                    </MudChip>
                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.HourglassTop">
                        Pendiente de Conciliación
                    </MudChip>
                    <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ErrorOutline">
                        Requiere Subsanación
                    </MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Info">
                        En Revisión de Kraal
                    </MudChip>
                    <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Lock">
                        Archivado / Cerrado
                    </MudChip>
                </div>
            </MudPaper>

            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                Banners de Alerta del Sistema
            </MudText>
            <div class="d-flex flex-column gap-3 mt-3">
                <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Elevation="1">
                    <strong>Inscripción registrada con éxito:</strong> Hemos recibido la documentación de Lucas. Se emitirá el aviso de pago en cuanto el Kraal verifique la plaza.
                </MudAlert>

                <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Elevation="1">
                    <strong>Plazo próximo a finalizar:</strong> Quedan menos de 72 horas para adjuntar el justificante bancario de la Acampada de San Jorge.
                </MudAlert>

                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Elevation="1">
                    <strong>Modelo no vigente:</strong> El documento adjunto pertenece a una versión obsoleta de la ficha médica. Descarga la plantilla vigente para tramitar la entrega.
                </MudAlert>
            </div>
        </MudTabPanel>

        <!-- PESTAÑA 3: PATRÓN FAMILIAR REAL -->
        <MudTabPanel Text="Expediente Familiar (Simulación)" Icon="@Icons.Material.Filled.FamilyRestroom">
            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                Patrón de Gestión Familiar: Aislamiento por Participante
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Las familias visualizan los trámites ordenados por educando, evitando mezclar expedientes entre hermanos en ramas distintas.
            </MudText>

            <MudGrid>
                <!-- Educando 1 -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Outlined="true" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Warning" Variant="Variant.Filled">L</MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Lucas Martín García</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" Icon="@Icons.Material.Filled.Pets">
                                    Manada de Lobatos
                                </MudChip>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                    1 Pendiente
                                </MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="background: #F8FAFC;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Acampada de San Jorge 2027</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">
                                        Cierre en 3 días
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-3">
                                    Lugar: Riópar (Albacete) · Cuota de actividad: 45,00 €
                                </MudText>
                                
                                <MudTimeline TimelinePosition="TimelinePosition.Left" Class="pa-0">
                                    <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                        <MudText Typo="Typo.caption"><strong>Autorización legal:</strong> Entregada v1 firmada</MudText>
                                    </MudTimelineItem>
                                    <MudTimelineItem Color="Color.Warning" Size="Size.Small">
                                        <MudText Typo="Typo.caption"><strong>Comprobante bancario:</strong> Adjunto (en revisión)</MudText>
                                    </MudTimelineItem>
                                </MudTimeline>
                            </MudPaper>
                        </MudCardContent>
                        <MudCardActions Class="justify-end gap-2 pa-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
                                Ficha Médica
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assignment">
                                Gestionar Trámite
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>

                <!-- Educando 2 -->
                <MudItem xs="12" md="6">
                    <MudCard Elevation="2" Outlined="true" Class="rounded-lg">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Info" Variant="Variant.Filled">L</MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700;">Lucía Martín García</MudText>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Explore">
                                    Sección Scout / Tropa
                                </MudChip>
                            </CardHeaderContent>
                            <CardHeaderActions>
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                    Al día
                                </MudChip>
                            </CardHeaderActions>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudPaper Elevation="0" Outlined="true" Class="pa-4" Style="background: #F8FAFC;">
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">Campamento de Pascua 2027</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">
                                        Plaza Confirmada
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.caption" Class="d-block mud-text-secondary mb-3">
                                    Lugar: Sierra de Alcaraz · Cuota de actividad: 60,00 €
                                </MudText>

                                <MudTimeline TimelinePosition="TimelinePosition.Left" Class="pa-0">
                                    <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                        <MudText Typo="Typo.caption"><strong>Autorización legal:</strong> Verificada por Scouter</MudText>
                                    </MudTimelineItem>
                                    <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                        <MudText Typo="Typo.caption"><strong>Abono bancario:</strong> Conciliado por tesorería</MudText>
                                    </MudTimelineItem>
                                </MudTimeline>
                            </MudPaper>
                        </MudCardContent>
                        <MudCardActions Class="justify-end gap-2 pa-4">
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small">
                                Ficha Médica
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download">
                                Descargar Comprobante
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- PESTAÑA 4: FORMULARIOS Y TABLA DE PARTICIPANTES -->
        <MudTabPanel Text="Formularios y Tablas" Icon="@Icons.Material.Filled.TableChart">
            <MudText Typo="Typo.h6" Class="mb-1" Style="font-weight: 700;">
                Mesa de Revisión y Formulario Accesible
            </MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
                Controles de formulario nativos de MudBlazor con validación de accesibilidad y tabla de datos con filtros.
            </MudText>

            <MudGrid Class="mb-6">
                <MudItem xs="12" md="6">
                    <MudTextField Label="Nombre completo del educando" 
                                  Variant="Variant.Outlined" 
                                  Value="@("Lucas Martín García")" 
