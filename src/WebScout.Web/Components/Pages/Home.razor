@code {
    private GrupoScout? _grupo;
    private List<GrupoScout> _gruposFederados = new();

    private string _nombreGrupoLimpio => Tenant.GroupName;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity?.IsAuthenticated == true)
        {
            if (user.IsInRole(RolesScout.Familia))
            {
                Navigation.NavigateTo("/familias");
                return;
            }
            if (user.IsInRole(RolesScout.Scouter))
            {
                Navigation.NavigateTo("/kraal/inscripciones");
                return;
            }
            if (user.IsInRole(RolesScout.Coordinacion) || user.IsInRole(RolesScout.Administracion))
            {
                Navigation.NavigateTo("/kraal/actividades");
                return;
            }
            if (user.IsInRole(RolesScout.SuperAdmin))
            {
                Navigation.NavigateTo("/admin/grupos");
                return;
            }
        }

        if (Tenant.IsResolved && Tenant.CurrentTenantId != Guid.Empty)
        {
            _grupo = await DbContext.GruposScout
                .AsNoTracking()
                .FirstOrDefaultAsync(g => g.Id == Tenant.CurrentTenantId);
        }
        else
        {
            _gruposFederados = await DbContext.GruposScout
                .AsNoTracking()
                .Where(g => g.Activo)
                .OrderBy(g => g.NumeroGrupo)
                .ToListAsync();
        }
    }

    private string ObtenerUrlGrupo(string slug)
    {
        var uri = new Uri(Navigation.Uri);
        var port = uri.Port != 80 && uri.Port != 443 ? $":{uri.Port}" : "";

        if (uri.Host.EndsWith("scoutsclm.org", StringComparison.OrdinalIgnoreCase))
        {
            return $"{uri.Scheme}://{slug}.scoutsclm.org{port}/";
        }

        return $"{uri.Scheme}://{slug}.localhost{port}/";
    }
}
