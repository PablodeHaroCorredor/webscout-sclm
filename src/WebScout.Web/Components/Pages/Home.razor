                <div class="d-flex flex-wrap gap-4 align-center">
                    <MudLink Href="/contacto" Typo="Typo.body2" Color="Color.Primary">Contacto y Buzón</MudLink>
                    <span style="color: #CBD5E1;">|</span>
                    <MudLink Href="/contacto" Typo="Typo.body2" Color="Color.Primary">Admisiones</MudLink>
