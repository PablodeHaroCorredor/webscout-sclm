@page "/"
@inject ITenantContext Tenant
@inject NavigationManager Navigation

<PageTitle>@(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM") · Plataforma Scout</PageTitle>

<div class="scout-container" style="max-width: 960px; margin: 2rem auto; font-family: var(--font-stack);">
    @* Cabecera Scout con los colores del grupo activo *@
    <div style="background: @(ActivePanoleta.BaseColorHex); color: @HeaderTextColor; padding: 2.5rem; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); border-bottom: 6px solid @(ActivePanoleta.BorderColorHex);">
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1.5rem;">
            <div>
                <span style="display: inline-block; background: rgba(255,255,255,0.2); padding: 0.25rem 0.75rem; border-radius: var(--radius-pill); font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                    ⚜️ SCLM Multitenant Platform
                </span>
                <h1 style="margin: 0.5rem 0 0.25rem 0; font-size: 2.2rem; font-weight: 800;">
                    @(Tenant.IsResolved ? Tenant.GroupName : "Portal Asociativo SCLM")
                </h1>
                <p style="margin: 0; opacity: 0.9; font-size: 1.05rem;">
                    Subdominio activo: <code style="background: rgba(0,0,0,0.25); color: #fff; padding: 0.2rem 0.4rem; border-radius: var(--radius-sm);">@(Tenant.IsResolved ? Tenant.TenantSlug : "sin-tenant")</code>
                    · Grupo Nº: <strong>@(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "-")</strong>
                </p>
            </div>
            
            @* Miniatura de la pañoleta scout paramétrica *@
            <div style="text-align: center; background: rgba(255,255,255,0.18); padding: 1rem 1.25rem; border-radius: var(--radius-md); border: 2px solid @(ActivePanoleta.BorderColorHex);">
                <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; margin-bottom: 0.35rem; letter-spacing: 0.5px;">Pañoleta Oficial</div>
                <PanoletaSvg Config="ActivePanoleta" Width="85" Height="68" />
            </div>
        </div>
    </div>

    @* Acceso directo al Muestrario de Diseño & Identidad Corporativa *@
    <div class="scout-card" style="margin-top: 1.75rem; border-left: 6px solid #4A148C; background: linear-gradient(to right, #FFFFFF, #FAF5FF);">
        <div class="scout-card-body scout-flex-between">
            <div>
                <span class="scout-badge scout-badge-info" style="margin-bottom: 0.4rem;">🎨 Muestrario Interactivo</span>
                <h3 class="scout-title-md" style="margin: 0.25rem 0;">Manual de Identidad y Sistema de Diseño (UI Kit)</h3>
                <p class="scout-text-muted" style="margin: 0; font-size: 0.9rem;">
                    Explora los tokens CSS, la escala tipográfica, las 5 ramas pedagógicas scouts y los componentes táctiles accesibles.
                </p>
            </div>
            <a href="diseno?tenant=@Tenant.TenantSlug" class="scout-btn scout-btn-primary" style="background: #4A148C; border-color: #38006B;">
                <span>✨</span> Ver Guía de Estilos y UI Kit
            </a>
        </div>
    </div>

    @* Selector de Grupos para probar en local *@
    <div style="margin-top: 1.75rem; background: #ffffff; border: 1px solid var(--scout-border-subtle); border-radius: var(--radius-md); padding: 1.5rem; box-shadow: var(--shadow-sm);">
        <h3 style="margin-top: 0; font-size: 1.15rem; color: #1e293b;">🔄 Selector de Tenant (Simular Subdominios en Local)</h3>
        <p style="color: #64748b; font-size: 0.9rem; margin-bottom: 1rem;">
            El middleware detecta automáticamente el subdominio o el parámetro de consulta. Haz clic en cualquiera de los dos grupos de prueba para verificar cómo cambia el contexto, el aislamiento y la identidad visual:
        </p>
        <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
            <a href="?tenant=lestonnac" class="scout-btn @(Tenant.TenantSlug != "sanvicente" ? "scout-btn-primary" : "scout-btn-secondary")">
                <span>⚜️</span> Lestonnac 330 (?tenant=lestonnac)
            </a>
            <a href="?tenant=sanvicente" class="scout-btn @(Tenant.TenantSlug == "sanvicente" ? "scout-btn-primary" : "scout-btn-secondary")">
                <span>⚜️</span> San Vicente 412 (?tenant=sanvicente)
            </a>
        </div>
    </div>

    @* Estado de la Arquitectura y Aislamiento *@
    <div style="margin-top: 1.75rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
        <div class="scout-card">
            <div class="scout-card-body">
                <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">🛡️ Aislamiento EF Core 10</div>
                <p style="color: #475569; font-size: 0.88rem; margin: 0;">
                    Global Query Filter activo: solo se consultan registros con <code>OrganizationId = @Tenant.CurrentTenantId</code>.
                </p>
            </div>
        </div>

        <div class="scout-card">
            <div class="scout-card-body">
                <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">👁️ Accesibilidad WCAG 2.2 AA</div>
                <p style="color: #475569; font-size: 0.88rem; margin: 0;">
                    Ratio de contraste verificado: <strong>@ContrastRatio.ToString("F2"):1</strong> (requisito mínimo: 4.5:1).
                </p>
            </div>
        </div>

        <div class="scout-card">
            <div class="scout-card-body">
                <div style="font-weight: 700; color: #0f172a; margin-bottom: 0.5rem;">🍕 Vertical Slice Architecture</div>
                <p style="color: #475569; font-size: 0.88rem; margin: 0;">
                    Monolito modular con slices autocontenidos en <code>Features/</code> sin capas artificiales.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private PanoletaConfig ActivePanoleta => Tenant.TenantSlug switch
    {
        "sanvicente" => PanoletaConfig.SanVicente412,
        _ => PanoletaConfig.Lestonnac330
    };

    private string HeaderTextColor => WcagContrastCalculator.GetAccessibleTextColor(ActivePanoleta.BaseColorHex);
    private double ContrastRatio => WcagContrastCalculator.CalculateContrastRatio(HeaderTextColor, ActivePanoleta.BaseColorHex);
}