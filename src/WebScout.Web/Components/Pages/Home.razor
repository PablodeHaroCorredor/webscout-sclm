@page "/"
@inject ITenantContext Tenant

<PageTitle>@(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM") · Plataforma Asociativa</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-0">
    <!-- Cabecera Limpia y Profesional -->
    <MudPaper Elevation="0" Outlined="true" Class="pa-6 pa-md-8 mb-6 rounded-lg" Style="background: #FFFFFF;">
        <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-4">
            <div>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Class="mb-2">
                    Scouts de Castilla-La Mancha (SCLM)
                </MudChip>
                <MudText Typo="Typo.h4" Style="font-weight: 800; color: #0F172A;">
                    @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")
                </MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                    Plataforma de gestión para grupos scout: censo, fichas médicas y convocatorias de actividades.
                </MudText>
            </div>
            <div class="d-flex align-center gap-2">
                <MudButton Variant="Variant.Outlined" 
                           Color="@(Tenant.TenantSlug == "lestonnac" ? Color.Primary : Color.Default)" 
                           Size="Size.Small" 
                           Href="?tenant=lestonnac">
                    Lestonnac 330
                </MudButton>
                <MudButton Variant="Variant.Outlined" 
                           Color="@(Tenant.TenantSlug == "sanvicente" ? Color.Primary : Color.Default)" 
                           Size="Size.Small" 
                           Href="?tenant=sanvicente">
                    San Vicente 412
                </MudButton>
            </div>
        </div>
    </MudPaper>

    <!-- Estado de Usuario Autenticado / Acceso Rápido -->
    <AuthorizeView>
        <Authorized>
            <MudCard Elevation="0" Outlined="true" Class="mb-6 rounded-lg" Style="border-left: 5px solid #2563EB;">
                <MudCardContent Class="pa-6">
                    <div class="d-flex align-center gap-3 mb-2">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Person" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">
                                Sesión iniciada como @context.User.Identity?.Name
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Pertenencia: <strong>@(Tenant.IsResolved ? Tenant.GroupName : "SCLM")</strong>
                            </MudText>
                        </div>
                    </div>

                    <MudDivider Class="my-3" />

                    <div class="d-flex flex-wrap gap-2">
                        <AuthorizeView Roles="Familia" Context="fam">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ChildCare" Href="/familias/educandos">
                                Fichas de Educandos
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.EventAvailable" Href="/familias/actividades">
                                Convocatorias y Salidas
                            </MudButton>
                        </AuthorizeView>

                        <AuthorizeView Roles="Scouter,Coordinacion,Administracion" Context="kraal">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Hiking" Href="/kraal/actividades">
                                Gestor de Actividades Kraal
                            </MudButton>
                        </AuthorizeView>
                    </div>
                </MudCardContent>
            </MudCard>
        </Authorized>
        <NotAuthorized>
            <MudCard Elevation="0" Outlined="true" Class="mb-6 rounded-lg">
                <MudCardContent Class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-4 pa-6">
                    <div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">
                            Acceso al Portal
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-1">
                            Inicia sesión con tu cuenta de familia o scouter para gestionar educandos o publicar actividades.
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               Href="/login"
                               StartIcon="@Icons.Material.Filled.Login">
                        Iniciar Sesión
                    </MudButton>
                </MudCardContent>
            </MudCard>
        </NotAuthorized>
    </AuthorizeView>
</MudContainer>
