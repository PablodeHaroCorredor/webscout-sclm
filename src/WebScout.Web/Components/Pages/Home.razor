@page "/"
@layout Layout.PublicLayout
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.EntityFrameworkCore
@using WebScout.Web.Common.Domain
@using WebScout.Web.Components.Publico
@using WebScout.Web.Features.Identity.Domain
@using WebScout.Web.Infrastructure.Persistence
@using WebScout.Web.Infrastructure.Tenancy
@inject ITenantContext Tenant
@inject NavigationManager Navigation
@inject WebScoutDbContext DbContext
@inject AuthenticationStateProvider AuthStateProvider
@inject UserContextModeService ContextService

@*
    Portada pública (prueba de concepto Tailwind). Renderizado estático: no abre circuito SignalR.
    Todo el contenido y la lógica proceden de la versión MudBlazor; solo cambia la capa visual.
*@

<PageTitle>@(EsGrupo ? $"{Tenant.GroupName} · Scouts de Castilla-La Mancha" : "WebScout SCLM · Federación de Scouts de Castilla-La Mancha")</PageTitle>

@if (EsGrupo)
{
    <!-- 1. Cabecera -->
    <section class="border-b border-slate-200 bg-linear-to-b from-white to-slate-50">
        <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6 md:py-20">
            <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full bg-primario px-3 py-1 text-xs font-bold tracking-wide text-sobre-primario">SCOUTS DE CASTILLA-LA MANCHA</span>
                <span class="rounded-full border border-primario px-3 py-1 text-xs font-semibold text-primario">GRUPO SCOUT Nº @Tenant.GroupNumber</span>
                @if (!string.IsNullOrWhiteSpace(_grupo?.Lema))
                {
                    <span class="hidden text-sm italic text-slate-600 md:inline">«@_grupo.Lema»</span>
                }
            </div>

            <h1 class="mt-6 max-w-3xl text-4xl font-extrabold leading-tight tracking-tight text-slate-900 md:text-5xl">
                Aventura, valores y amistad en el @Tenant.GroupName
            </h1>
            <p class="mt-4 max-w-2xl text-lg leading-relaxed text-slate-600">
                Educación en el tiempo libre para niños y jóvenes de 6 a 21 años. Descubrimos la naturaleza, aprendemos en equipo y construimos un mundo mejor a través del método scout.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
                <a href="/contacto" class="@BotonPrimario">
                    <Icono Trazado="@Icons.Material.Filled.PersonAddAlt1" />
                    Solicitar plaza
                </a>
                <a href="#secciones" class="@BotonSecundario">
                    <Icono Trazado="@Icons.Material.Filled.Groups" />
                    Conocer las secciones
                </a>
                <a href="/login" class="inline-flex items-center gap-2 rounded-xl px-4 py-3 font-semibold text-slate-700 hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primario">
                    <Icono Trazado="@Icons.Material.Filled.Login" />
                    Portal de familias
                </a>
            </div>

            <ul class="mt-10 grid gap-4 border-t border-slate-200 pt-6 text-sm font-semibold text-slate-700 sm:grid-cols-2 lg:grid-cols-4">
                <li class="flex items-center gap-2"><Icono Trazado="@Icons.Material.Filled.Verified" Clase="size-5 text-primario" />Más de 40 años de trayectoria scout</li>
                <li class="flex items-center gap-2"><Icono Trazado="@Icons.Material.Filled.Forest" Clase="size-5 text-green-700" />Salidas y campamentos en la naturaleza</li>
                <li class="flex items-center gap-2"><Icono Trazado="@Icons.Material.Filled.Diversity3" Clase="size-5 text-sky-700" />5 secciones de 6 a 21 años</li>
                <li class="flex items-center gap-2"><Icono Trazado="@Icons.Material.Filled.VolunteerActivism" Clase="size-5 text-amber-700" />Educadores voluntarios titulados</li>
            </ul>
        </div>
    </section>

    <div class="mx-auto max-w-6xl space-y-16 px-4 py-16 sm:px-6">
        <!-- 2. Secciones pedagógicas -->
        <section id="secciones" aria-labelledby="titulo-secciones" class="scroll-mt-8">
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-bold tracking-widest text-primario">MÉTODO SCOUT PROGRESIVO</p>
                <h2 id="titulo-secciones" class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">Nuestras secciones</h2>
                <p class="mt-3 text-slate-600">Cada etapa responde a los intereses y capacidades de cada edad, desde el juego en la infancia hasta el compromiso adulto.</p>
            </div>

            <ul class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-6">
                @foreach (var seccion in Secciones)
                {
                    <li class="@($"flex flex-col rounded-2xl border p-6 {seccion.Tarjeta} {seccion.Ancho}")">
                        <div class="flex items-start gap-4">
                            <span class="@($"grid size-12 shrink-0 place-items-center rounded-full {seccion.Avatar}")">
                                <Icono Trazado="@seccion.Icono" Clase="size-6" />
                            </span>
                            <div class="min-w-0 flex-1">
                                <div class="flex flex-wrap items-center justify-between gap-2">
                                    <h3 class="@($"text-lg font-bold {seccion.Titulo}")">@seccion.Nombre</h3>
                                    <span class="@($"rounded-full px-2.5 py-0.5 text-xs font-bold {seccion.Insignia}")">@seccion.Edades</span>
                                </div>
                                <p class="@($"text-sm font-semibold {seccion.Titulo}")">@seccion.Lema</p>
                            </div>
                        </div>
                        <p class="mt-4 flex-1 text-[0.9375rem] leading-relaxed text-slate-700">@seccion.Descripcion</p>
                        <a href="/contacto" class="@($"mt-5 rounded-lg border-2 px-4 py-2 text-center text-sm font-semibold focus-visible:outline-2 focus-visible:outline-offset-2 {seccion.Boton}")">
                            Solicitar plaza en @seccion.NombreCorto
                        </a>
                    </li>
                }
            </ul>
        </section>

        <!-- 3. Los 4 pilares del método -->
        <section aria-labelledby="titulo-metodo" class="rounded-3xl border border-slate-200 bg-white p-8 md:p-10">
            <div class="mx-auto max-w-2xl text-center">
                <p class="text-xs font-bold tracking-widest text-primario">NUESTRA METODOLOGÍA</p>
                <h2 id="titulo-metodo" class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">¿Por qué el escultismo marca la diferencia?</h2>
                <p class="mt-3 text-slate-600">Más de un siglo formando ciudadanos libres, responsables, solidarios y comprometidos con su entorno.</p>
            </div>
            <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
                @foreach (var pilar in Pilares)
                {
                    <li>
                        <span class="@($"grid size-11 place-items-center rounded-full {pilar.Color}")"><Icono Trazado="@pilar.Icono" /></span>
                        <h3 class="mt-4 text-lg font-bold">@pilar.Titulo</h3>
                        <p class="mt-2 text-sm leading-relaxed text-slate-600">@pilar.Texto</p>
                    </li>
                }
            </ul>
        </section>

        <!-- 4. Reuniones y contacto -->
        <section aria-labelledby="titulo-reuniones" class="grid items-start gap-8 md:grid-cols-2">
            <div>
                <p class="text-xs font-bold tracking-widest text-primario">DINÁMICA DE GRUPO</p>
                <h2 id="titulo-reuniones" class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">¿Cuándo y dónde nos reunimos?</h2>
                <p class="mt-4 leading-relaxed text-slate-600">
                    Nuestra actividad se realiza durante todo el curso escolar (de octubre a julio), combinando reuniones semanales en la sede con salidas de fin de semana.
                </p>
                <ul class="mt-6 space-y-3">
                    @foreach (var reunion in Reuniones)
                    {
                        <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-4">
                            <Icono Trazado="@reunion.Icono" Clase="@($"mt-0.5 size-5 shrink-0 {reunion.Color}")" />
                            <div>
                                <p class="font-bold">@reunion.Titulo</p>
                                <p class="text-sm text-slate-600">@reunion.Texto</p>
                            </div>
                        </li>
                    }
                </ul>
            </div>

            <div class="rounded-3xl border border-slate-200 bg-white p-8">
                <h2 class="text-2xl font-extrabold">Información de contacto</h2>
                <p class="mt-2 text-sm text-slate-600">Para dudas o comunicarte con los responsables de sección o secretaría del grupo:</p>
                <dl class="mt-6 space-y-4 text-[0.9375rem]">
                    <div class="flex items-center gap-3">
                        <Icono Trazado="@Icons.Material.Filled.Email" Clase="size-5 shrink-0 text-primario" />
                        <dt class="font-bold">Correo:</dt>
                        <dd class="min-w-0 break-words text-slate-700">
                            <a href="@($"mailto:{EmailGrupo}")" class="text-primario underline underline-offset-2">@EmailGrupo</a>
                        </dd>
                    </div>
                    <div class="flex items-center gap-3">
                        <Icono Trazado="@Icons.Material.Filled.Place" Clase="size-5 shrink-0 text-primario" />
                        <dt class="font-bold">Sede:</dt>
                        <dd class="text-slate-700">Castilla-La Mancha</dd>
                    </div>
                    <div class="flex items-center gap-3">
                        <Icono Trazado="@Icons.Material.Filled.Security" Clase="size-5 shrink-0 text-primario" />
                        <dt class="font-bold">Federación:</dt>
                        <dd class="text-slate-700">Scouts de Castilla-La Mancha</dd>
                    </div>
                </dl>
                <a href="/contacto" class="@($"{BotonPrimario} mt-8 w-full justify-center")">
                    <Icono Trazado="@Icons.Material.Filled.QuestionAnswer" />
                    Enviar un mensaje o consulta
                </a>
            </div>
        </section>

        <!-- 5. Preguntas frecuentes: <details> nativo, accesible por teclado y sin JavaScript -->
        <section aria-labelledby="titulo-faq">
            <div class="text-center">
                <p class="text-xs font-bold tracking-widest text-primario">DUDAS HABITUALES</p>
                <h2 id="titulo-faq" class="mt-2 text-3xl font-extrabold tracking-tight md:text-4xl">Preguntas frecuentes</h2>
            </div>
            <div class="mx-auto mt-8 max-w-3xl divide-y divide-slate-200 rounded-2xl border border-slate-200 bg-white">
                @foreach (var pregunta in PreguntasFrecuentes)
                {
                    <details class="group p-5 [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-lg font-semibold focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primario">
                            @pregunta.Pregunta
                            <Icono Trazado="@Icons.Material.Filled.ExpandMore" Clase="size-6 shrink-0 text-slate-500 transition-transform group-open:rotate-180" />
                        </summary>
                        <p class="mt-3 leading-relaxed text-slate-600">@pregunta.Respuesta</p>
                    </details>
                }
            </div>
        </section>

        <!-- 6. Llamada final -->
        <section class="rounded-3xl bg-slate-900 px-6 py-12 text-center text-white md:px-12">
            <p class="inline-block rounded-full bg-primario px-3 py-1 text-xs font-bold text-sobre-primario">ÚNETE A NUESTRO GRUPO SCOUT</p>
            <h2 class="mt-4 text-3xl font-extrabold tracking-tight md:text-4xl">¿Quieres formar parte de la aventura?</h2>
            <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-slate-300">
                Presenta tu solicitud a la lista de espera de @Tenant.GroupName. Secretaría la revisará y se pondrá en contacto contigo cuando haya plaza.
            </p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="/contacto" class="@BotonPrimario">
                    <Icono Trazado="@Icons.Material.Filled.PersonAddAlt1" />
                    Solicitar admisión
                </a>
                <a href="/contacto" class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-6 py-3 font-semibold text-white hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                    <Icono Trazado="@Icons.Material.Filled.Mail" />
                    Hacer una consulta
                </a>
            </div>
        </section>
    </div>

    <!-- 7. Pie -->
    <footer class="border-t border-slate-200 bg-white">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm sm:px-6 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="font-bold">@Tenant.GroupName</p>
                <p class="text-slate-600">Grupo Scout Nº @Tenant.GroupNumber, federado en Scouts de Castilla-La Mancha (SCLM).</p>
            </div>
            <nav aria-label="Pie de página" class="flex flex-wrap gap-x-6 gap-y-2">
                <a href="/contacto" class="font-semibold text-primario underline-offset-2 hover:underline">Contacto</a>
                <a href="/contacto" class="font-semibold text-primario underline-offset-2 hover:underline">Admisiones</a>
                <a href="/login" class="font-semibold text-primario underline-offset-2 hover:underline">Acceso Kraal y familias</a>
            </nav>
        </div>
    </footer>
}
else
{
    <!-- Portal de la federación (dominio central) -->
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
        <section class="rounded-3xl bg-slate-900 p-8 text-white md:p-12">
            <p class="inline-block rounded-full bg-white/10 px-3 py-1 text-xs font-bold tracking-wide">FEDERACIÓN REGIONAL SCLM</p>
            <h1 class="mt-4 text-4xl font-extrabold tracking-tight md:text-5xl">Scouts de Castilla-La Mancha</h1>
            <p class="mt-4 max-w-3xl text-lg leading-relaxed text-slate-300">
                Plataforma de gestión para los Grupos Scout de Castilla-La Mancha. Cada grupo dispone de su propio portal en un entorno seguro y aislado.
            </p>
            <div class="mt-8 flex flex-wrap gap-3">
                <AuthorizeView Roles="SuperAdmin">
                    <Authorized>
                        <a href="/admin/grupos" class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3 font-bold text-slate-900 hover:bg-slate-100">
                            <Icono Trazado="@Icons.Material.Filled.AdminPanelSettings" />
                            Panel central SuperAdmin
                        </a>
                    </Authorized>
                </AuthorizeView>
                <a href="/login" class="inline-flex items-center gap-2 rounded-xl border-2 border-white/40 px-6 py-3 font-semibold hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
                    <Icono Trazado="@Icons.Material.Filled.Login" />
                    Iniciar sesión
                </a>
            </div>
        </section>

        <section aria-labelledby="titulo-grupos" class="mt-12">
            <h2 id="titulo-grupos" class="text-2xl font-extrabold md:text-3xl">Grupos Scout federados</h2>
            <p class="mt-2 text-slate-600">Selecciona un grupo para acceder a su portal público, admisiones o gestión de familias.</p>

            <ul class="mt-8 grid gap-6 md:grid-cols-2">
                @foreach (var grupo in _gruposFederados)
                {
                    <li class="flex flex-col rounded-2xl border border-slate-200 bg-white p-6">
                        <div class="flex items-center gap-4">
                            <span class="grid size-14 shrink-0 place-items-center rounded-full bg-slate-900 text-lg font-extrabold text-white">@grupo.NumeroGrupo</span>
                            <div class="min-w-0">
                                <h3 class="text-lg font-bold">@grupo.Nombre</h3>
                                <p class="truncate text-sm text-slate-600">@ObtenerUrlGrupo(grupo.Slug)</p>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(grupo.Lema))
                        {
                            <p class="mt-4 text-sm italic text-slate-700">«@grupo.Lema»</p>
                        }
                        <div class="mt-6 flex flex-wrap items-center gap-3">
                            <a href="@ObtenerUrlGrupo(grupo.Slug)" class="inline-flex items-center gap-2 rounded-lg bg-slate-900 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-700">
                                Entrar a @grupo.Nombre
                                <Icono Trazado="@Icons.Material.Filled.ArrowForward" Clase="size-4" />
                            </a>
                            <a href="@($"{ObtenerUrlGrupo(grupo.Slug)}contacto")" class="rounded-lg px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-100">Admisiones</a>
                        </div>
                    </li>
                }
            </ul>
        </section>
    </div>
}

@code {
    // Clases completas en el código: Tailwind solo genera las clases que encuentra escritas enteras
    private const string BotonPrimario = "inline-flex items-center gap-2 rounded-xl bg-primario px-6 py-3 font-bold text-sobre-primario shadow-sm hover:brightness-110 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primario";
    private const string BotonSecundario = "inline-flex items-center gap-2 rounded-xl border-2 border-primario px-6 py-3 font-semibold text-primario hover:bg-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primario";

    private sealed record SeccionPedagogica(
        string Nombre, string NombreCorto, string Edades, string Lema, string Descripcion, string Icono,
        string Tarjeta, string Avatar, string Titulo, string Insignia, string Boton, string Ancho);

    private static readonly SeccionPedagogica[] Secciones =
    [
        new("Castores", "Castores", "6 – 8 años", "Lema: «Compartir» · Colonia",
