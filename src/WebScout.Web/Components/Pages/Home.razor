        new("¿Qué material o uniforme se necesita para empezar?",
            "Para las primeras reuniones basta con ropa cómoda y calzado deportivo. Cuando el educando decide comprometerse con el grupo, tras su periodo de integración, recibe la pañoleta y puede adquirir la camisa scout para actos y campamentos."),
    ];

    private GrupoScout? _grupo;
    private List<GrupoScout> _gruposFederados = new();

    private bool EsGrupo => Tenant.IsResolved && Tenant.CurrentTenantId != Guid.Empty;
    private string EmailGrupo => _grupo?.EmailContacto ?? "coordinacion@scoutslestonnac.es";

    protected override async Task OnInitializedAsync()
    {
        // Con sesión iniciada, la portada lleva a cada perfil a su zona de gestión.
        // En renderizado estático, NavigateTo se traduce en una redirección HTTP.
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        var destino = user.Identity?.IsAuthenticated == true ? DestinoPorRol(user) : null;
        if (destino is not null)
        {
            Navigation.NavigateTo(destino);
            return;
        }

        if (EsGrupo)
        {
            _grupo = await DbContext.GruposScout.AsNoTracking()
                .FirstOrDefaultAsync(g => g.Id == Tenant.CurrentTenantId);
        }
        else
        {
            _gruposFederados = await DbContext.GruposScout.AsNoTracking()
                .Where(g => g.Activo)
                .OrderBy(g => g.NumeroGrupo)
                .ToListAsync();
        }
    }

    private string? DestinoPorRol(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole(RolesScout.SuperAdmin)) return "/admin/grupos";

        var esGlobal = user.IsInRole(RolesScout.Coordinacion) || user.IsInRole(RolesScout.Administracion);
        var esKraal = esGlobal || user.IsInRole(RolesScout.Scouter);
        var esFamilia = user.IsInRole(RolesScout.Familia);

        if (esKraal && esFamilia && ContextService.CurrentMode == ScoutContextMode.Familia) return "/familias";
        if (esGlobal) return "/kraal/actividades";
        if (esKraal) return "/kraal/inscripciones";
        if (esFamilia) return "/familias";
        return null;
    }

    private string ObtenerUrlGrupo(string slug)
    {
        var uri = new Uri(Navigation.Uri);
        var puerto = uri.IsDefaultPort ? "" : $":{uri.Port}";
        var dominio = uri.Host.EndsWith("scoutsclm.org", StringComparison.OrdinalIgnoreCase) ? "scoutsclm.org" : "localhost";
        return $"{uri.Scheme}://{slug}.{dominio}{puerto}/";
    }
}
