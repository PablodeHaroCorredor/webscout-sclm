@page "/"
@inject ITenantContext Tenant

<PageTitle>@(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM") · Plataforma Federativa</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-8">
    <MudPaper Elevation="0" Outlined="true" Class="pa-8 text-center rounded-lg" Style="background: #FFFFFF;">
        <div class="d-flex justify-center mb-4">
            <PanoletaSvg Config="ActivePanoleta" Width="90" Height="72" />
        </div>
        <MudText Typo="Typo.h4" Style="font-weight: 800; letter-spacing: -0.02em;" Class="mb-2">
            @(Tenant.IsResolved ? Tenant.GroupName : "WebScout SCLM")
        </MudText>
        <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
            Plataforma integral de gestión asociativa para Scouts de Castilla-La Mancha.
        </MudText>
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            Subdominio activo: @(Tenant.IsResolved ? Tenant.TenantSlug : "sin-tenant") (Censo: @(Tenant.IsResolved ? Tenant.GroupNumber.ToString() : "-"))
        </MudChip>
    </MudPaper>
</MudContainer>

@code {
    private PanoletaConfig ActivePanoleta => Tenant.TenantSlug switch
    {
        "sanvicente" => PanoletaConfig.SanVicente412,
        _ => PanoletaConfig.Lestonnac330
    };
}
