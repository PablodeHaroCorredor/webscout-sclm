            "border-green-700 text-green-800 hover:bg-green-100 focus-visible:outline-green-700", "sm:col-span-2 lg:col-span-3"),
    ];

    private sealed record Elemento(string Icono, string Color, string Titulo, string Texto);

    private static readonly Elemento[] Pilares =
    [
        new(Icons.Material.Filled.Cabin, "bg-green-700 text-white", "Vida en la naturaleza",
            "El medio natural es nuestra mejor escuela. Fomentamos el respeto ecológico, la austeridad y el disfrute al aire libre sin pantallas."),
        new(Icons.Material.Filled.Groups, "bg-primario text-sobre-primario", "Pequeños equipos",
