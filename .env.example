# Configuración local de desarrollo - WebScout SCLM
# Copiar este archivo a .env o usar dotnet user-secrets en local

# Base de datos PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=webscout_dev;Username=scout_admin;Password=scout_dev_password_change_me

# Almacenamiento de archivos S3 / MinIO local
Storage__Provider=S3
Storage__Endpoint=http://localhost:9000
Storage__AccessKey=scout_minio_admin
Storage__SecretKey=scout_minio_secret_key
Storage__BucketName=scout-private-documents
Storage__ForcePathStyle=true

# Servicio de Correo SMTP (Mailpit local)
Mail__SmtpHost=localhost
Mail__SmtpPort=1025
Mail__FromEmail=notificaciones@scoutsclm.org
Mail__FromName=WebScout SCLM

# Cifrado AES-256-GCM de datos de salud (RGPD Art. 9)
# En Development puede quedar vacía: se usa la clave pública de desarrollo (solo datos sintéticos).
# Fuera de Development es OBLIGATORIA (mínimo 32 caracteres) y la aplicación no arranca sin ella.
# Generar una con PowerShell:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
Seguridad__ClaveCifradoDatosSensibles=

# Entorno y Tenancy
ASPNETCORE_ENVIRONMENT=Development
Tenancy__BaseDomain=scoutsclm.org
Tenancy__FallbackTenantSlug=lestonnac
